---
/**
 * ChatBox — Unified ChatComposer Surface — Mobile ChatGPT-style pill
 * - Desktop: 28px radius, bg #252525, border white/10, unified suggestions
 * - Mobile: pill dark grey (#212121), bottom-anchored like screenshot, plus grey circle left, mic+wave white circles right
 * Preserves all JS behaviour and copy (Ask anything)
 */
import Plus from '@lucide/astro/icons/plus';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Mic from '../../../assets/svgs/mic.svg';
import Dices from '@lucide/astro/icons/dices';
import questionsData from '../../../data/question-templates.json';

const { cn = "" } = Astro.props;

// FIXED_SUGGESTIONS removed — suggestions are now dynamic only (3-char threshold + ILIKE filter)
---

<!-- Pass questions data to client -->
<script type="application/json" id="chat-questions-data" set:html={JSON.stringify(questionsData.questions)}></script>

<style>
  .composer {
    border-radius: 28px;
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(37,37,37,.96);
    box-shadow: 0 10px 30px rgba(0,0,0,.28);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 720px;
    margin-inline: auto;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .composer:focus-within {
    border-color: rgba(255,255,255,.22);
    box-shadow: 0 10px 30px rgba(0,0,0,.28), 0 0 0 2px rgba(255,255,255,.10);
  }

  /* Collapsible suggestions panel */
  :global(.suggestions-panel) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: height 200ms ease, opacity 140ms ease;
  }
  :global(.suggestions-panel[data-collapsed="true"]) {
    height: 0 !important;
    opacity: 0;
    pointer-events: none;
  }

  :global(.suggest-row) {
    width: 100%;
    min-height: 44px;
    padding: 0 16px;
    text-align: left;
    font-size: 14px;
    line-height: 1.35;
    color: rgba(255,255,255,.88);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: background 140ms ease, color 140ms ease;
  }
  :global(.suggest-row:hover) { background: rgba(255,255,255,.045); color: #fff; }
  :global(.suggest-row:focus-visible) {
    outline: none;
    background: rgba(255,255,255,.06);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
  }
  :global(.suggest-row .chevron) {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 140ms ease, transform 140ms ease;
    color: rgba(255,255,255,.35);
  }
  :global(.suggest-row:hover .chevron),
  :global(.suggest-row:focus-visible .chevron) {
    opacity: 1;
    transform: translateX(0);
  }

  .composer-textarea {
    width: 100%;
    resize: none;
    background: transparent;
    border: none;
    outline: none;
    padding: 10px 14px 0 14px;
    font-size: 15px;
    line-height: 24px;
    color: #fff;
    min-height: 48px;
    max-height: 200px;
    overflow-y: auto;
    vertical-align: top;
  }
  .composer-textarea::placeholder { color: rgba(255,255,255,.38); }
  .composer-textarea::-webkit-scrollbar { width: 0; height: 0; }

  #disclaimer { transition: opacity 120ms ease; }

  /* === MOBILE ChatGPT screenshot match === */
  @media (max-width: 768px) {
    .composer {
      border-radius: 20px;
      min-height: 112px;
      width: calc(100% - 24px);
      border: 1px solid rgba(255,255,255,.08);
      background: #212121;
      box-shadow: 0 4px 24px rgba(0,0,0,.4);
    }
    .suggestions-panel[data-collapsed="true"] { height: 0 !important; }
    .composer-textarea { padding: 8px 12px 6px 12px; font-size: 16px; min-height: 44px; }
    .composer-textarea::placeholder { color: rgba(255,255,255,.45); }
    :global(.suggest-row) { min-height: 44px; font-size: 14px; }
    :global(.suggest-row .chevron) { display: none; }
    .composer-inner {
      padding: 10px 10px 10px 10px !important;
    }
    .composer-textarea {
      padding: 8px 10px 6px 12px;
      font-size: 16px;
      color: rgba(255,255,255,.92);
    }
    .composer-textarea::placeholder { color: rgba(255,255,255,.45); }
    :global(.suggest-row) { min-height: 44px; font-size: 14px; }
    :global(.suggest-row .chevron) { display: none; }

    /* plus button: screenshot shows dark gray circle with white plus at bottom-left of pill */
    #add-btn-main {
      background: #3a3a3a !important;
      width: 36px !important;
      height: 36px !important;
      color: #fff !important;
    }
    #add-btn-main:hover { background: #464646 !important; }

    /* mic + wave: screenshot shows two WHITE circles with black icons at bottom-right */
    #mic-btn {
      background: #fff !important;
      color: #000 !important;
      width: 36px !important;
      height: 36px !important;
      box-shadow: 0 1px 2px rgba(0,0,0,.15);
    }
    #mic-btn:hover { background: #f2f2f2 !important; }
    #mic-btn svg { color: #000 !important; }

    #send-btn {
      width: 36px !important;
      height: 36px !important;
      background: #fff !important;
      color: #000 !important;
    }
    #send-btn[aria-disabled='true'] {
      opacity: 0.7 !important; /* slight dim for non-submittable interim text, still clickable */
    }

    /* make bottom row tighter like screenshot */
    #composer-actions {
      padding-top: 8px !important;
      padding-left: 4px !important;
      padding-right: 4px !important;
    }
    /* mobile overrides */
    .suggestions-panel[data-collapsed="true"] { height: 0 !important; }
    .suggestions-panel { max-height: min(40vh, 264px); overflow-y: auto; }
    .suggestions-panel::-webkit-scrollbar { width: 0; height: 0; }
  }

  /* === DICE SUGGESTIONS === */
  :global(.dice-row) {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(251,191,36,.20);
    border-radius: 10px;
    margin: 0 2px;
  }
  :global(.dice-row:hover) { background: rgba(251,191,36,.08); border-color: rgba(251,191,36,.35); }
  :global(.dice-row .dice-glyph) { color: #f59e0b; }

  /* Dice header */
  :global(.dice-header) {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: rgba(251,191,36,.65);
    padding: 2px 18px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  :global(.dice-header .reroll-hint) {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: rgba(255,255,255,.30);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    transition: color 140ms;
  }
  :global(.dice-header .reroll-hint:hover) { color: rgba(251,191,36,.65); }

  /* Icon tumble animation */
  @keyframes dice-tumble {
    0%   { transform: rotate(0deg)   translateX(0);    }
    15%  { transform: rotate(-20deg) translateX(-2px); }
    35%  { transform: rotate(15deg)  translateX(2px);  }
    55%  { transform: rotate(-12deg) translateX(-1px); }
    75%  { transform: rotate(8deg)   translateX(1px);  }
    90%  { transform: rotate(-4deg)  translateX(0);    }
    100% { transform: rotate(0deg)   translateX(0);    }
  }
  :global(.dice-tumbling) { animation: dice-tumble 450ms cubic-bezier(.36,.07,.19,.97) both; }

  /* Staggered row entrance */
  :global(.dice-row-enter) {
    opacity: 0;
    transform: translateY(6px);
  }
  :global(.dice-row-entered) {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }
  :global(.dice-row-entered.pop) { animation: dice-pop 150ms ease-out 1; }
  @keyframes dice-pop {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.025); }
    100% { transform: scale(1); }
  }

  /* Reduced motion: instant render */
  @media (prefers-reduced-motion: reduce) {
    :global(.dice-tumbling),
    :global(.dice-row-enter),
    :global(.dice-row-entered),
    :global(.dice-row-entered.pop) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import '../chatbox-client.ts';
</script>

<div id="chatbox-container" class:list={["w-full flex-shrink-0 bg-gradient-to-t from-black via-black to-transparent", cn]}>
  <div class="mx-auto w-full max-w-[48rem] px-4 pb-[calc(1.5rem+env(safe-area-inset-bottom))] md:pb-6 pt-2">
    <!-- Disclaimer — di ATAS textarea, hanya muncul setelah chat dimulai -->
    <p id="disclaimer" class="hidden mb-3 text-center text-[11px] leading-4 text-zinc-500">
      ChatGPT can make mistakes. <button type="button" class="underline decoration-zinc-500 underline-offset-2 hover:text-zinc-300 transition-colors">I'm here to fix that.</button>
    </p>

    <!-- Unified Composer Surface — compact stacked (per UI/UX guide redesign) -->
    <section id="composer" class="composer" aria-label="Message composer">

      <!-- Collapsible suggestions panel (filtered only — no fixed suggestions) -->
      <div id="suggestions-panel" class="suggestions-panel">
        <!-- FIXED_SUGGESTIONS removed — suggestions are now dynamic only -->
        <div id="filtered-suggestions" class="divide-y divide-white/[0.06]"></div>
      </div>

      <!-- Divider — only show when suggestions visible -->
      <div id="composer-divider" class="hidden h-px bg-white/[0.07]"></div>

      <!-- sr-only live region for screen readers -->
      <div id="dice-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>

      <!-- Composer Input: auto-grow textarea + actions -->
      <div class="composer-inner relative w-full px-1.5 pb-2.5 pt-2.5">
        <p id="input-helper" class="hidden text-[11px] text-amber-400/80 px-3 pb-1.5">Please select from suggestions — only questions from list are allowed.</p>

        <textarea
          id="chat-input"
          placeholder="Ask anything"
          rows="1"
          class="composer-textarea pt-0"
        ></textarea>

        <!-- Bottom row: plus left, mic + wave white right -->
        <div id="composer-actions" class="flex items-center justify-between gap-2 px-1.5 pt-2.5">
          <div id="plus-wrap" class="flex items-center">
            <a id="add-btn-main" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 md:bg-transparent hover:bg-white/10 md:hover:bg-white/10 transition-colors" href="/cv" aria-label="View CV">
              <Plus class="w-5 h-5 text-zinc-200 md:text-zinc-300" />
            </a>
          </div>
          <div id="icons-wrap" class="flex items-center gap-2">
            <button id="mic-btn" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 md:bg-transparent hover:bg-white/10 md:hover:bg-white/10 transition-colors" type="button" aria-label="Voice input">
              <Mic class="w-5 h-5 text-zinc-200 md:text-zinc-300" />
            </button>
            <button id="send-btn" class="flex h-10 w-10 items-center justify-center rounded-full transition-all bg-white text-black shadow-sm hover:bg-zinc-100 active:scale-[.98] cursor-pointer opacity-100" type="button" aria-label="Roll random questions" aria-disabled="false">
              <Dices id="send-icon-default" class="w-5 h-5 text-black" />
              <ArrowUp id="send-icon-active" class="w-5 h-5 text-black hidden" />
            </button>
          </div>
        </div>
      </div>
    </section>
    </div>
  </div>
</div>
