---
import type { CvSkill } from "../types";

interface Props {
  skills: CvSkill[];
}

const { skills } = Astro.props;
---

{skills.length > 0 && (
  <section class="cv-section mb-8">
    <h2 class="mb-3 border-b border-black pb-1.5 text-[13px] font-[700] uppercase tracking-[0.08em] text-black">
      Skills
    </h2>
    <div class="space-y-3">
      {skills.map((group) => (
        <div>
          <h3 class="mb-1.5 text-[14px] font-[700] text-black">{group.name}</h3>
          <div class="flex flex-wrap gap-1.5">
            {group.keywords.map((kw) => (
              <span class="rounded-full border border-black/[0.12] bg-black/[0.03] px-2.5 py-0.5 text-[12px] text-zinc-700">
                {kw}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
