---
/**
 * integrations/ChatHistory.astro
 * Pure Astro integration wrapper — SPA ready, no Alpine
 * Previously Alpine wrapper, now Astro-only for speed.
 * Future: can add client:load islands here when experimenting multi-framework.
 */
import ChatHistory from '../components/ChatHistory.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div data-integration="chat-history" class:list={[className]}>
  <ChatHistory />
</div>

<script>
  // SPA-ready: listen to nanostores for visibility, no Alpine.store
  import { $hasChats } from '../stores/chat';

  const root = document.querySelector('[data-integration="chat-history"]') as HTMLElement | null;
  if (root) {
    const update = (has: boolean) => {
      root.style.display = has ? '' : '';
      // previously x-show — now always render, ChatHistory itself handles empty vs thread
    };
    try {
      $hasChats.subscribe(update);
    } catch {}
  }
</script>
