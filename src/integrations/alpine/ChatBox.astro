---
import Plus from '@lucide/astro/icons/plus';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Mic from '../../assets/svgs/mic.svg';
import SpeakWave from '../../assets/svgs/speak-wave.svg';
import questionsData from '../../data/question-templates.json';
---

<script>
  import Alpine from 'alpinejs';
  import { setHasChats } from '../../stores/chat';
  
  window.setHasChats = setHasChats;
  
  // Expose questions data for Alpine
  window.questionsData = questionsData.questions;
  
  Alpine.data('chatBox', () => ({
    input: '',
    isTextWrapped: false,
    isChatted: false,
    questions: window.questionsData,
    resize() {
      this.$refs.input.style.height = 'auto';
      this.$refs.input.style.height = this.$refs.input.scrollHeight + 'px';
      this.isTextWrapped = this.input.length > 74;
    },
    submit() {
      if (this.input.trim()) {
        const userQuestion = this.input.trim();
        this.isChatted = true;
        
        // Find matching answer
        const matched = this.questions.find(q => 
          userQuestion.toLowerCase().includes(q.question.toLowerCase()) ||
          q.question.toLowerCase().includes(userQuestion.toLowerCase())
        );
        
        const answer = matched ? matched.answer : "I'm sorry, I don't have an answer for that question yet. Try asking about me!";
        
        // Update nanostores to show ChatHistory
        window.setHasChats(true);
        
        this.input = '';
        this.resize();
      }
    }
  }));
</script>

<style>
    .chat-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .chat-scrollbar::-webkit-scrollbar-track {
        background: #2f2f2f;
        border-radius: 3px;
    }
    .chat-scrollbar::-webkit-scrollbar-thumb {
        background: #555;
        border-radius: 3px;
    }
    .chat-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #777;
    }
</style>

<div class="flex flex-col items-center justify-center w-full flex-1 min-h-0">
    <div
        x-data="chatBox()"
        x-init="resize()"
        x-effect="resize()"
        class="flex flex-col items-center max-w-2xl w-full"
    >
        {/* Header - before chat */}
        <h1 x-show="!isChatted" class="text-2xl text-center w-full mb-6">Mind to know me better?</h1>

        {/* Disclaimer - after chat */}
        <p x-show="isChatted" class="text-xs text-gray-500 text-center mt-2 my-2">
            ChatGPT can make mistakes. I can fix that.
        </p>

        {/* Input bar */}
        <div
            class="w-full bg-[#2f2f2f] rounded-3xl px-4 py-3 my-2"
            :class="isTextWrapped ? 'flex flex-col gap-2' : 'flex items-center gap-2'"
        >
            <div
                class="flex items-center gap-2"
                :class="isTextWrapped ? 'order-1' : 'flex-1'"
            >
                <button x-show="!isTextWrapped" class="flex-shrink-0 p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                    <Plus class="w-5 h-5 text-gray-300" />
                </button>

                <textarea
                    x-ref="input"
                    x-model="input"
                    @input="resize()"
                    @keydown.enter.prevent="submit()"
                    placeholder="Ask anything"
                    rows="1"
                    class="w-full bg-transparent text-white placeholder-gray-400 outline-none text-sm resize-none overflow-y-auto min-h-[24px] max-h-[200px] chat-scrollbar"
                ></textarea>
            </div>

            <div
                class="flex items-center gap-2"
                :class="isTextWrapped ? 'order-2 justify-between' : ''"
            >
                <button x-show="isTextWrapped" class="flex-shrink-0 p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                    <Plus class="w-5 h-5 text-gray-300" />
                </button>

                <div class="flex items-center gap-2" :class="isTextWrapped ? 'ml-auto' : ''">
                    <button class="flex-shrink-0 p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                        <Mic class="w-5 h-5 text-gray-300" />
                    </button>

                    <button @click="submit()" class="flex-shrink-0 p-1.5 rounded-full transition-colors" :class="input.trim() ? 'bg-white hover:bg-[--primary-color]' : 'bg-white hover:bg-[--primary-color]'">
                        <span x-show="input.trim()">
                            <ArrowUp class="w-5 h-5 text-black" />
                        </span>
                        <span x-show="!input.trim()">
                            <SpeakWave class="w-5 h-5 text-black" />
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>