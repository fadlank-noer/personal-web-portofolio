---
/**
 * LinkConfirmationModal — ChatGPT-style confirmation before opening links
 * - Fade-in 150ms
 * - Smart positioning: prefer below-right, flip above/left when viewport is tight
 * - Closes on Cancel / outside click / Escape
 * - Confirm → window.open with noopener,noreferrer
 */
---

<div id="link-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="link-confirm-title" class="hidden fixed z-50">
  <div id="link-confirm-backdrop" class="fixed inset-0" aria-hidden="true"></div>
  <div id="link-confirm-panel" class="relative bg-[#212121] border border-[#2f2f2f] rounded-2xl shadow-2xl w-72 max-w-[calc(100vw-24px)]">
    <div class="p-4">
      <p id="link-confirm-title" class="text-[14px] font-medium text-white mb-1">Open this link?</p>
      <p id="link-confirm-url" class="text-[12px] text-zinc-400 truncate mb-4" title=""></p>
      <div class="flex gap-2 justify-end">
        <button id="link-confirm-cancel" type="button" class="flex-1 px-3 py-2 text-[13px] font-medium rounded-xl bg-white/8 text-zinc-300 hover:bg-white/14 transition-colors border border-white/10">Cancel</button>
        <button id="link-confirm-open" type="button" class="flex-1 px-3 py-2 text-[13px] font-medium rounded-xl bg-white text-black hover:bg-zinc-100 transition-colors">Open Link</button>
      </div>
    </div>
  </div>
</div>

<style>
  #link-confirm-modal {
    animation: link-modal-in 150ms ease backwards;
  }
  @keyframes link-modal-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  #link-confirm-panel {
    animation: link-panel-in 150ms ease backwards;
  }
  @keyframes link-panel-in {
    from { opacity: 0; transform: scale(0.95) translateY(4px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>

<script>
  function initLinkModal() {
    const modal = document.getElementById('link-confirm-modal');
    const panel = document.getElementById('link-confirm-panel');
    const backdrop = document.getElementById('link-confirm-backdrop');
    const urlEl = document.getElementById('link-confirm-url');
    const cancelBtn = document.getElementById('link-confirm-cancel');
    const openBtn = document.getElementById('link-confirm-open');

    if (!modal || !panel || !urlEl || !cancelBtn || !openBtn) return;
    if ((modal as HTMLElement).dataset.bound === 'true') return;
    (modal as HTMLElement).dataset.bound = 'true';

    let activeUrl = '';
    let triggerRect: DOMRect | null = null;

    function showModal(url: string, rect: DOMRect) {
      activeUrl = url;
      triggerRect = rect;

      // Truncate display URL
      const display = url.length > 50 ? url.slice(0, 47) + '…' : url;
      urlEl.textContent = display;
      urlEl.setAttribute('title', url);

      // Smart positioning
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const pW = panel.offsetWidth || 288;
      const pH = panel.offsetHeight || 140;
      const GAP = 8;

      let top = 0, left = 0;
      const below = rect.bottom + GAP + pH <= vh;
      const above = rect.top - GAP - pH >= 0;

      if (below || !above) {
        // Place below
        top = rect.bottom + GAP + window.scrollY;
      } else {
        // Place above
        top = rect.top - GAP - pH + window.scrollY;
      }

      const rightOf = rect.left + GAP + pW <= vw;
      const leftOf = rect.left - GAP - pW >= 0;

      if (rightOf) {
        left = rect.left + window.scrollX;
      } else if (leftOf) {
        left = rect.left + rect.width - pW + window.scrollX;
      } else {
        // Center horizontally
        left = Math.max(12, (vw - pW) / 2 + window.scrollX);
      }

      (panel as HTMLElement).style.top = `${top}px`;
      (panel as HTMLElement).style.left = `${left}px`;
      (panel as HTMLElement).style.right = 'auto';

      modal.classList.remove('hidden');
      openBtn.focus();
    }

    function hideModal() {
      modal.classList.add('hidden');
      activeUrl = '';
      triggerRect = null;
    }

    function confirmOpen() {
      if (activeUrl) {
        window.open(activeUrl, '_blank', 'noopener,noreferrer');
      }
      hideModal();
    }

    // Close on Cancel
    cancelBtn.addEventListener('click', hideModal);

    // Close on Open
    openBtn.addEventListener('click', confirmOpen);

    // Close on backdrop click
    backdrop?.addEventListener('click', hideModal);

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        hideModal();
      }
    });

    // Delegate: listen for [data-link-trigger] clicks anywhere in the page
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-link-trigger]');
      if (!btn) return;
      const url = (btn as HTMLElement).dataset.linkUrl || '';
      if (!url) return;
      e.preventDefault(); // suppress native <a> navigation; modal controls the open
      const rect = (btn as HTMLElement).getBoundingClientRect();
      showModal(url, rect);
    });

    // Update modal position on scroll/resize (for fixed trigger elements)
    window.addEventListener('scroll', hideModal, { passive: true });
    window.addEventListener('resize', hideModal);
  }

  initLinkModal();
  document.addEventListener('astro:page-load', initLinkModal);
</script>