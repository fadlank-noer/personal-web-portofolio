---
/**
 * MediaGallery — GPT-style responsive image gallery
 * Layouts: 1=hero, 2=50/50, 3=asymmetric (2fr+1fr desktop, hero-top mobile), 4=2x2, 5+=4preview+N
 * Treats entire gallery as ONE object — outer radius only, 4px gap
 */
import type { MediaItem } from '../../../lib/types/chat';

interface Props {
  items: MediaItem[];
  maxPreview?: number; // max tiles to show before +N overlay (default 4)
  galleryId: string;   // unique id for this gallery instance (used by viewer)
  onOpenViewer?: (index: number) => void; // callback: open viewer at index
}

const {
  items = [],
  maxPreview = 4,
  galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`,
  onOpenViewer,
} = Astro.props;

const count = items.length;
const hasImages = count > 0;
const previewItems = hasImages ? items.slice(0, maxPreview) : [];
const remaining = count - maxPreview;
const layout = hasImages
  ? count === 1 ? 'single'
  : count === 2 ? 'two'
  : count === 3 ? 'three'
  : 'grid'
  : 'none';
---

{hasImages && (
  <div
    class="media-gallery"
    data-count={count}
    data-layout={layout}
    data-gallery-id={galleryId}
    role="group"
    aria-label={`${count} image${count !== 1 ? 's' : ''} in response`}
  >
    {layout === 'single' && (
      <button
        type="button"
        class="gallery-tile tile-single"
        data-tile-index="0"
        aria-label={`Open image 1 of ${count}`}
        onclick={`window.__mediaViewer__.open('${galleryId}', 0)`}
      >
        <img
          src={previewItems[0].src}
          alt={previewItems[0].alt || 'Image'}
          loading="lazy"
          class="tile-img"
        />
        <div class="tile-skeleton" aria-hidden="true"></div>
      </button>
    )}

    {layout === 'two' && (
      previewItems.map((item, i) => (
        <button
          type="button"
          class="gallery-tile tile-two"
          data-tile-index={String(i)}
          aria-label={`Open image ${i + 1} of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', ${i})`}
        >
          <img
            src={item.src}
            alt={item.alt || `Image ${i + 1}`}
            loading="lazy"
            class="tile-img"
          />
          <div class="tile-skeleton" aria-hidden="true"></div>
        </button>
      ))
    )}

    {layout === 'three' && (
      <>
        <button
          type="button"
          class="gallery-tile tile-three-hero"
          data-tile-index="0"
          aria-label={`Open image 1 of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', 0)`}
        >
          <img
            src={previewItems[0].src}
            alt={previewItems[0].alt || 'Image 1'}
            loading="lazy"
            class="tile-img"
          />
          <div class="tile-skeleton" aria-hidden="true"></div>
        </button>
        <div class="tile-three-stack">
          {previewItems.slice(1, 3).map((item, i) => (
            <button
              type="button"
              class="gallery-tile tile-three-sub"
              data-tile-index={String(i + 1)}
              aria-label={`Open image ${i + 2} of ${count}`}
              onclick={`window.__mediaViewer__.open('${galleryId}', ${i + 1})`}
            >
              <img
                src={item.src}
                alt={item.alt || `Image ${i + 2}`}
                loading="lazy"
                class="tile-img"
              />
              <div class="tile-skeleton" aria-hidden="true"></div>
            </button>
          ))}
        </div>
      </>
    )}

    {(layout === 'grid' || count > 4) && (
      <>
        {previewItems.slice(0, 3).map((item, i) => (
          <button
            type="button"
            class="gallery-tile tile-grid"
            data-tile-index={String(i)}
            aria-label={`Open image ${i + 1} of ${count}`}
            onclick={`window.__mediaViewer__.open('${galleryId}', ${i})`}
          >
            <img
              src={item.src}
              alt={item.alt || `Image ${i + 1}`}
              loading="lazy"
              class="tile-img"
            />
            <div class="tile-skeleton" aria-hidden="true"></div>
          </button>
        ))}
        {/* 4th tile: last preview OR +N overlay */}
        <button
          type="button"
          class="gallery-tile tile-grid tile-more"
          data-tile-index="3"
          aria-label={count > maxPreview ? `View ${count - maxPreview + 1} more images` : `Open image ${maxPreview} of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', ${maxPreview - 1})`}
        >
          <img
            src={previewItems[maxPreview - 1]?.src ?? previewItems[maxPreview - 1]?.src ?? ''}
            alt={previewItems[maxPreview - 1]?.alt ?? 'Image'}
            loading="lazy"
            class="tile-img"
          />
          {remaining > 0 && (
            <div class="tile-more-overlay" aria-hidden="true">
              <span>+{remaining}</span>
            </div>
          )}
          <div class="tile-skeleton" aria-hidden="true"></div>
        </button>
      </>
    )}
  </div>
)}

<style>
  /* === Gallery Container === */
  .media-gallery {
    --gallery-radius: 14px;
    --gallery-gap: 4px;
    --tile-transition: 180ms ease;
    --tile-scale: 1.015;

    display: grid;
    gap: var(--gallery-gap);
    border-radius: var(--gallery-radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    cursor: zoom-in;
    max-width: 100%;
  }

  /* === Single image === */
  .media-gallery[data-count="1"] {
    grid-template-columns: 1fr;
  }

  .tile-single {
    position: relative;
    display: block;
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  /* === Two images: 50/50 === */
  .media-gallery[data-count="2"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tile-two {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  /* === Three images: 2fr + 1fr stacked (desktop) === */
  .media-gallery[data-count="3"] {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .tile-three-hero {
    grid-row: 1 / span 2;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  .tile-three-stack {
    display: contents;
  }

  .tile-three-sub {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  /* === 4+ images: 2x2 grid === */
  .media-gallery[data-count="4"],
  .media-gallery[data-count="many"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .tile-grid {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  /* === +N Overlay === */
  .tile-more {
    position: relative;
  }

  .tile-more-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.52);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    pointer-events: none;
  }

  /* === Tile Image === */
  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--tile-transition);
  }

  /* === Hover Effect === */
  .gallery-tile:hover .tile-img {
    transform: scale(var(--tile-scale));
  }

  /* === Skeleton / Loading === */
  .tile-skeleton {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.06);
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .tile-img[src] + .tile-skeleton,
  .tile-img:not([src=""]) {
    /* skeleton hides once image has src and loads */
  }

  .tile-img.loaded + .tile-skeleton {
    opacity: 0;
  }

  /* === Reduced Motion === */
  @media (prefers-reduced-motion: reduce) {
    .tile-img {
      transition: none;
    }
    .tile-skeleton {
      transition: none;
    }
  }

  /* === Mobile: 3 images stacked === */
  @media (max-width: 480px) {
    .media-gallery[data-count="3"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 1.4fr 1fr;
    }

    .media-gallery[data-count="3"] .tile-three-hero {
      grid-column: 1 / span 2;
      grid-row: 1;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .media-gallery[data-count="3"] .tile-three-stack {
      display: contents;
    }

    .media-gallery[data-count="3"] .tile-three-sub {
      aspect-ratio: 4 / 3;
    }
  }

  /* === Mobile: gallery height caps === */
  @media (max-width: 480px) {
    .tile-single {
      max-height: 65vw;
    }

    .tile-two,
    .tile-grid {
      aspect-ratio: 1 / 1;
    }
  }
</style>

<script>
  // Skeleton fade-out once images load
  document.querySelectorAll('.tile-img').forEach((img) => {
    if ((img as HTMLImageElement).complete) {
      img.classList.add('loaded');
      const skeleton = img.parentElement?.querySelector('.tile-skeleton');
      if (skeleton) skeleton.setAttribute('style', 'opacity:0');
    } else {
      img.addEventListener('load', () => {
        img.classList.add('loaded');
        const skeleton = img.parentElement?.querySelector('.tile-skeleton');
        if (skeleton) skeleton.setAttribute('style', 'opacity:0');
      });
      img.addEventListener('error', () => {
        img.classList.add('loaded');
        const skeleton = img.parentElement?.querySelector('.tile-skeleton');
        if (skeleton) skeleton.setAttribute('style', 'opacity:0');
      });
    }
  });
</script>