---
/**
 * MediaGallery — GPT-style responsive image gallery
 * Layouts: 1=hero contain (max 640x420), 2=50/50 (8px gap, stack <400px), 3=asymmetric (2fr+1fr desktop, hero-top mobile), 4=2x2, 5+=4preview+N
 * Treats entire gallery as ONE object — outer radius only
 * Premium generating UX: shimmer skeleton 1.8s → blur(8px)→0 + opacity .5→1 reveal 250ms
 * Error state per tile: "Image couldn't be generated" + Try again (retry cap 2) — never browser broken-image
 */
import type { MediaItem } from '../../../lib/types/chat';

interface Props {
  items: MediaItem[];
  maxPreview?: number;
  galleryId: string;
  onOpenViewer?: (index: number) => void;
}

const {
  items = [],
  maxPreview = 4,
  galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`,
  onOpenViewer,
} = Astro.props as Props & { onOpenViewer?: (index: number) => void };

const count = items.length;
const hasImages = count > 0;
const previewItems = hasImages ? items.slice(0, maxPreview) : [];
const remaining = count - maxPreview;
const layout = hasImages
  ? count === 1 ? 'single'
  : count === 2 ? 'two'
  : count === 3 ? 'three'
  : 'grid'
  : 'none';
---

{hasImages && (
  <div
    class="media-gallery"
    data-count={count}
    data-layout={layout}
    data-gallery-id={galleryId}
    role="group"
    aria-label={`${count} image${count !== 1 ? 's' : ''} in response`}
  >
    {layout === 'single' && (
      <button
        type="button"
        class="gallery-tile tile-single"
        data-tile-index="0"
        aria-label={`Open image 1 of ${count}`}
        onclick={`window.__mediaViewer__.open('${galleryId}', 0)`}
      >
        <img
          src={previewItems[0].src}
          alt={previewItems[0].alt || 'Image'}
          loading="lazy"
          class="tile-img"
        />
        <div class="tile-skeleton" aria-hidden="true"></div>
        <div class="tile-error" hidden aria-hidden="true">
          <span class="tile-error-text">Image couldn't be generated</span>
          <span class="tile-retry" role="button" tabindex="0">Try again</span>
        </div>
      </button>
    )}

    {layout === 'two' && (
      previewItems.map((item: MediaItem, i: number) => (
        <button
          type="button"
          class="gallery-tile tile-two"
          data-tile-index={String(i)}
          aria-label={`Open image ${i + 1} of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', ${i})`}
        >
          <img
            src={item.src}
            alt={item.alt || `Image ${i + 1}`}
            loading="lazy"
            class="tile-img"
          />
          <div class="tile-skeleton" aria-hidden="true"></div>
          <div class="tile-error" hidden aria-hidden="true">
            <span class="tile-error-text">Image couldn't be generated</span>
            <span class="tile-retry" role="button" tabindex="0">Try again</span>
          </div>
        </button>
      ))
    )}

    {layout === 'three' && (
      <>
        <button
          type="button"
          class="gallery-tile tile-three-hero"
          data-tile-index="0"
          aria-label={`Open image 1 of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', 0)`}
        >
          <img
            src={previewItems[0].src}
            alt={previewItems[0].alt || 'Image 1'}
            loading="lazy"
            class="tile-img"
          />
          <div class="tile-skeleton" aria-hidden="true"></div>
          <div class="tile-error" hidden aria-hidden="true">
            <span class="tile-error-text">Image couldn't be generated</span>
            <span class="tile-retry" role="button" tabindex="0">Try again</span>
          </div>
        </button>
        <div class="tile-three-stack">
          {previewItems.slice(1, 3).map((item: MediaItem, i: number) => (
            <button
              type="button"
              class="gallery-tile tile-three-sub"
              data-tile-index={String(i + 1)}
              aria-label={`Open image ${i + 2} of ${count}`}
              onclick={`window.__mediaViewer__.open('${galleryId}', ${i + 1})`}
            >
              <img
                src={item.src}
                alt={item.alt || `Image ${i + 2}`}
                loading="lazy"
                class="tile-img"
              />
              <div class="tile-skeleton" aria-hidden="true"></div>
              <div class="tile-error" hidden aria-hidden="true">
                <span class="tile-error-text">Image couldn't be generated</span>
                <span class="tile-retry" role="button" tabindex="0">Try again</span>
              </div>
            </button>
          ))}
        </div>
      </>
    )}

    {(layout === 'grid' || count > 4) && (
      <>
        {previewItems.slice(0, 3).map((item, i) => (
          <button
            type="button"
            class="gallery-tile tile-grid"
            data-tile-index={String(i)}
            aria-label={`Open image ${i + 1} of ${count}`}
            onclick={`window.__mediaViewer__.open('${galleryId}', ${i})`}
          >
            <img
              src={item.src}
              alt={item.alt || `Image ${i + 1}`}
              loading="lazy"
              class="tile-img"
            />
            <div class="tile-skeleton" aria-hidden="true"></div>
            <div class="tile-error" hidden aria-hidden="true">
              <span class="tile-error-text">Image couldn't be generated</span>
              <span class="tile-retry" role="button" tabindex="0">Try again</span>
            </div>
          </button>
        ))}
        {/* 4th tile: last preview OR +N overlay */}
        <button
          type="button"
          class="gallery-tile tile-grid tile-more"
          data-tile-index="3"
          aria-label={count > maxPreview ? `View ${count - maxPreview + 1} more images` : `Open image ${maxPreview} of ${count}`}
          onclick={`window.__mediaViewer__.open('${galleryId}', ${maxPreview - 1})`}
        >
          <img
            src={previewItems[maxPreview - 1]?.src ?? ''}
            alt={previewItems[maxPreview - 1]?.alt ?? 'Image'}
            loading="lazy"
            class="tile-img"
          />
          {remaining > 0 && (
            <div class="tile-more-overlay" aria-hidden="true">
              <span>+{remaining}</span>
            </div>
          )}
          <div class="tile-skeleton" aria-hidden="true"></div>
          <div class="tile-error" hidden aria-hidden="true">
            <span class="tile-error-text">Image couldn't be generated</span>
            <span class="tile-retry" role="button" tabindex="0">Try again</span>
          </div>
        </button>
      </>
    )}
  </div>
)}

<style>
  /* === Gallery Container === */
  .media-gallery {
    --gallery-radius: 14px;
    --gallery-gap: 4px;
    --tile-transition: 180ms ease;
    --tile-scale: 1.015;
    --tile-border: rgba(255, 255, 255, 0.07);
    --tile-surface: rgba(255, 255, 255, 0.055);

    display: grid;
    gap: var(--gallery-gap);
    border-radius: var(--gallery-radius);
    overflow: hidden;
    background: var(--tile-surface);
    cursor: zoom-in;
    max-width: 100%;
  }

  /* === Single image — contain, max 640x420, preserve original aspect === */
  .media-gallery[data-count="1"] {
    grid-template-columns: 1fr;
    max-width: 640px;
  }

  .tile-single {
    position: relative;
    display: block;
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    background: var(--tile-surface);
  }

  .media-gallery[data-count="1"] .tile-img {
    object-fit: contain;
  }

  /* === Two images: 50/50, 8px gap, stack when tiles too narrow === */
  .media-gallery[data-count="2"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tile-two {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--tile-surface);
  }

  /* === Three images: 2fr + 1fr stacked (desktop) === */
  .media-gallery[data-count="3"] {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .tile-three-hero {
    grid-row: 1 / span 2;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--tile-surface);
  }

  .tile-three-stack {
    display: contents;
  }

  .tile-three-sub {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--tile-surface);
  }

  /* === 4+ images: 2x2 grid === */
  .media-gallery[data-count="4"],
  .media-gallery[data-count="many"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .tile-grid {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--tile-surface);
  }

  /* === Tile base: subtle border + dark elevated surface (guide §9) === */
  .gallery-tile {
    border: 1px solid var(--tile-border);
    border-radius: 14px;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .gallery-tile:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.07);
  }

  /* === +N Overlay === */
  .tile-more {
    position: relative;
  }

  .tile-more-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.52);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    pointer-events: none;
  }

  /* === Tile Image — blur reveal (guide §14) === */
  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.5;
    filter: blur(8px);
    transition: opacity 250ms ease, filter 250ms ease, transform var(--tile-transition);
  }

  .tile-img.loaded {
    opacity: 1;
    filter: blur(0);
  }

  .gallery-tile:hover .tile-img {
    transform: scale(var(--tile-scale));
  }

  /* === Skeleton / Loading — subtle shimmer 1.8s (guide §20) === */
  .tile-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(255,255,255,0.06) 40%, rgba(255,255,255,0.10) 50%, rgba(255,255,255,0.06) 60%);
    background-size: 200% 100%;
    animation: tile-shimmer 1.8s linear infinite;
    opacity: 1;
    transition: opacity 300ms ease;
  }

  @keyframes tile-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .tile-img.loaded + .tile-skeleton {
    opacity: 0;
  }

  /* === Error state — never browser broken-image (guide §13) === */
  .tile-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.62);
    cursor: pointer;
    z-index: 2;
  }

  .tile-error[hidden] {
    display: none;
  }

  .tile-error-text {
    font-size: 13px;
    line-height: 1.4;
    padding: 0 12px;
    text-align: center;
  }

  .tile-retry {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 4px 12px;
    transition: background 140ms ease;
  }

  .tile-retry:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* === Reduced Motion (guide §17) === */
  @media (prefers-reduced-motion: reduce) {
    .tile-skeleton {
      animation: none;
      background: rgba(255, 255, 255, 0.06);
    }
    .tile-img,
    .tile-img.loaded {
      transition: none;
      opacity: 1;
      filter: none;
    }
    .gallery-tile:hover {
      transform: none;
    }
  }

  /* === Mobile: 3 images stacked === */
  @media (max-width: 480px) {
    .media-gallery[data-count="3"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 1.4fr 1fr;
    }

    .media-gallery[data-count="3"] .tile-three-hero {
      grid-column: 1 / span 2;
      grid-row: 1;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .media-gallery[data-count="3"] .tile-three-stack {
      display: contents;
    }

    .media-gallery[data-count="3"] .tile-three-sub {
      aspect-ratio: 4 / 3;
    }
  }

  /* === Mobile: gallery height caps === */
  @media (max-width: 480px) {
    .tile-single {
      max-height: 65vw;
    }

    .tile-two,
    .tile-grid {
      aspect-ratio: 1 / 1;
    }
  }

  /* === Narrow: two-image gallery stacks to 1 column (guide §8) === */
  @media (max-width: 400px) {
    .media-gallery[data-count="2"] {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Skeleton fade-out, blur reveal, and error state — component tiles only
  // (runtime inline galleries in ChatHistory handle themselves via .skeleton)
  function initTiles(scope: HTMLElement) {
    scope.querySelectorAll('.gallery-tile').forEach((tile: Element) => {
      if ((tile as HTMLElement).dataset.bound === 'true') return;
      const errorEl = tile.querySelector('.tile-error');
      if (!errorEl) return; // runtime gallery tile — handled by ChatHistory
      (tile as HTMLElement).dataset.bound = 'true';

      const img = tile.querySelector('img') as HTMLImageElement;
      const skeleton = tile.querySelector('.tile-skeleton') as HTMLElement | null;
      const error = errorEl as HTMLElement;
      const attempts = { n: 0 };

      function showError() {
        img.style.display = 'none';
        if (skeleton) skeleton.style.opacity = '0';
        error.hidden = false;
      }

      function retry() {
        attempts.n += 1;
        if (attempts.n > 2) return; // retry cap
        error.hidden = true;
        img.style.display = '';
        if (skeleton) skeleton.style.opacity = '';
        img.classList.remove('loaded');
        const src = img.getAttribute('src') || '';
        img.src = '';
        img.src = src;
      }

      error.addEventListener('click', (e) => { e.stopPropagation(); retry(); });
      error.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); e.stopPropagation(); retry(); }
      });

      if (img.complete) {
        if (img.naturalWidth > 0) {
          img.classList.add('loaded');
          if (skeleton) skeleton.style.opacity = '0';
        } else {
          showError();
        }
      } else {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
          if (skeleton) skeleton.style.opacity = '0';
        });
        img.addEventListener('error', showError);
      }
    });
  }

  initTiles(document.body);
  const observer = new MutationObserver(() => initTiles(document.body));
  observer.observe(document.body, { childList: true, subtree: true });
</script>
