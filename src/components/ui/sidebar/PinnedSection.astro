---
/**
 * PinnedSection — simplified: text-only title, hover bg-[#141414]
 * project = circular avatar, notion = chat bubble, legacy = gray circle
 */
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import SquarePen from '@lucide/astro/icons/square-pen';
import ChatBubble from '../../../assets/svgs/chat.svg';
import type { PinnedItem } from '../../../lib/types/sidebar';

interface Props { items: PinnedItem[]; }
const { items } = Astro.props;

const AVATAR_COLORS = [
  'from-violet-500 to-purple-600',
  'from-blue-500 to-cyan-500',
  'from-emerald-500 to-teal-500',
  'from-orange-500 to-amber-500',
  'from-pink-500 to-rose-500',
  'from-indigo-500 to-blue-500',
];

function getAvatarColor(id: string) {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = id.charAt(i).charCodeAt(0) + ((hash << 5) - hash);
  return AVATAR_COLORS[Math.abs(hash) % AVATAR_COLORS.length];
}

function getInitial(title: string) {
  return title.trim()[0]?.toUpperCase() ?? '?';
}
---

<div data-section-wrap="pinned" class="group/section bg-black">
  <div class="group/header flex h-[32px] w-full items-center justify-between px-1 rounded-md hover:bg-[#0a0a0a] transition-colors">
    <button data-section-toggle="pinned" class="flex items-center gap-1 bg-black group-hover/header:bg-[#0a0a0a] text-white transition-colors">
      <span class="text-[13px] font-[600] leading-none tracking-tight sidebar-label">Pinned</span>
      <ChevronDown class="h-[12px] w-[12px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-all duration-150 sidebar-label hover-reveal" data-chevron="pinned" />
    </button>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="More">
        <Ellipsis class="h-[14px] w-[14px]" />
      </button>
      <button id="pinned-edit" class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="Edit">
        <SquarePen class="h-[14px] w-[14px]" />
      </button>
    </div>
  </div>
  <div data-section-content="pinned" class="mt-1 space-y-0.5 sidebar-section-content bg-black px-1 overflow-hidden">
        {items.length === 0 ? (
          <p class="px-2 py-1.5 text-[12px] text-zinc-600 sidebar-label">No pinned</p>
        ) : items.map((p) => (
          <button
            type="button"
            data-link-trigger
            data-link-url={p.meta || ''}
            data-link-label={p.title}
            class="group/item flex items-center gap-2 rounded-lg px-2 py-2 text-[13px] text-zinc-400 hover:bg-[#141414] hover:text-white transition-colors text-left overflow-hidden w-full"
          >
            {p.type === 'notion' ? (
              <ChatBubble class="h-4 w-4 flex-shrink-0 text-white/70 group-hover/item:text-white transition-colors [&_path]:fill-white" />
            ) : p.type === 'project' ? (
              <div class={`h-6 w-6 flex-shrink-0 rounded-full bg-gradient-to-br ${getAvatarColor(p.id)} flex items-center justify-center text-[10px] font-semibold text-white`}>
                {getInitial(p.title)}
              </div>
            ) : (
              <div class="h-4 w-4 flex-shrink-0 rounded-full bg-zinc-700" />
            )}
            <span class="truncate sidebar-label leading-tight min-w-0 flex-1">{p.title}</span>
          </button>
        ))}
      </div>
</div>