---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import SquarePen from '@lucide/astro/icons/square-pen';
import Images from '@lucide/astro/icons/images';
import Film from '@lucide/astro/icons/film';
import type { LibraryItem } from '../../../lib/types/sidebar';

interface Props { items: LibraryItem[]; }
const { items } = Astro.props;
const imageCount = items.filter(l=>l.type==='image').length;
const videoCount = items.filter(l=>l.type==='video').length;
---
<div data-section-wrap="library" class="group/section bg-black">
  <div class="group/header flex h-[32px] w-full items-center justify-between bg-black px-1 rounded-md hover:bg-[#0a0a0a] transition-colors">
    <button data-section-toggle="library" class="flex items-center gap-1 bg-black group-hover/header:bg-[#0a0a0a] text-white transition-colors">
      <span class="text-[13px] font-[600] leading-none tracking-tight sidebar-label">Library</span>
      <ChevronDown class="h-[12px] w-[12px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-all duration-150 sidebar-label hover-reveal" data-chevron="library" />
    </button>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
      <span class="hidden sm:flex items-center gap-1 text-[10px] text-zinc-600 sidebar-label hover-reveal"><Images class="h-3 w-3" />{imageCount} <Film class="h-3 w-3 ml-1" />{videoCount}</span>
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="More">
        <Ellipsis class="h-[14px] w-[14px]" />
      </button>
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="Edit">
        <SquarePen class="h-[14px] w-[14px]" />
      </button>
    </div>
  </div>
  <div data-section-content="library" class="mt-2 px-1 sidebar-section-content bg-black">
    <div class="masonry-grid columns-2 gap-2 [column-fill:_balance]">
      {items.map((m) => (
        <div class:list={[
          "masonry-item group/card break-inside-avoid mb-2 relative w-full overflow-hidden rounded-[12px] border border-white/[0.06] bg-gradient-to-br transition-all hover:border-white/[0.12] hover:-translate-y-0.5 cursor-pointer",
          m.color,
          m.ratio,
          m.wide ? "[column-span:all]" : ""
        ]}>
          <div class="absolute inset-0">
            <div class="h-full w-full opacity-50 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.12),transparent_40%)]"></div>
          </div>
          <div class="absolute inset-0 flex flex-col justify-between p-2">
            <div class="flex justify-between items-start">
              <span class="rounded-full bg-black/50 backdrop-blur px-1.5 py-0.5 text-[9px] font-medium text-white/60 border border-white/10">{m.type}</span>
              {m.type === 'video' && <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white text-[10px] text-black">▶</span>}
            </div>
            <span class="truncate rounded bg-black/60 backdrop-blur px-1.5 py-0.5 text-[10px] text-white/70 border border-white/5">{m.label}</span>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover/card:bg-black/20 transition-colors"></div>
        </div>
      ))}
    </div>
    <div class="mt-2 rounded-lg bg-black border border-white/[0.06] p-2.5 sidebar-label">
      <p class="text-[11px] leading-[14px] text-zinc-600"><span class="text-zinc-400 font-medium">Masonry</span> — <code class="text-zinc-500">aspect-*</code> + <code class="text-zinc-500">[column-span:all]</code></p>
      <div class="mt-2 flex gap-1.5">
        <button id="library-add-random" class="rounded-md bg-[#141414] hover:bg-[#1f1f1f] px-2 py-1 text-[11px] text-zinc-400 transition-colors">+ Add random</button>
        <button class="rounded-md bg-[#141414] hover:bg-[#1f1f1f] px-2 py-1 text-[11px] text-zinc-400 transition-colors">Open</button>
      </div>
    </div>
  </div>
</div>
