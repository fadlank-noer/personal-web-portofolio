---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import SquarePen from '@lucide/astro/icons/square-pen';
import FolderIcon from '../../../assets/svgs/folder.svg';
import type { ProjectItem } from '../../../lib/types/sidebar';

interface Props { items: ProjectItem[]; }
const { items } = Astro.props;
---
<div data-section-wrap="projects" class="group/section bg-black">
  <div class="group/header flex h-[32px] w-full items-center justify-between bg-black px-1 rounded-md hover:bg-[#0a0a0a] transition-colors">
    <button data-section-toggle="projects" class="flex items-center gap-1.5 bg-black group-hover/header:bg-[#0a0a0a] text-white transition-colors">
      <FolderIcon class="h-[14px] w-[14px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-opacity" />
      <span class="text-[13px] font-[600] leading-none tracking-tight sidebar-label">Projects</span>
      <ChevronDown class="h-[12px] w-[12px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-all duration-150 sidebar-label hover-reveal" data-chevron="projects" />
    </button>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
      <span class="text-[10px] rounded bg-[#141414] px-1.5 py-0.5 text-zinc-500 sidebar-label hover-reveal">{items.length}</span>
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="More"><Ellipsis class="h-[14px] w-[14px]" /></button>
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="Edit"><SquarePen class="h-[14px] w-[14px]" /></button>
    </div>
  </div>
  <div data-section-content="projects" class="mt-1 space-y-0.5 sidebar-section-content bg-black px-1">
    {items.slice(0, 3).map((pr) => (
      <a href={pr.url || `/projects/${pr.id}`} class="group/proj flex w-full items-center gap-2.5 rounded-lg px-2 py-2 hover:bg-[#141414] transition-colors">
        <span class={`relative h-6 w-6 rounded-[6px] ${pr.color} flex items-center justify-center text-[11px] font-bold text-white flex-shrink-0`}>
          {pr.thumb}
          {pr.featured && <span class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full bg-white ring-2 ring-black" />}
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-[13px] leading-tight text-zinc-300 group-hover/proj:text-white sidebar-label">{pr.title}</span>
          <span class="block truncate text-[11px] text-zinc-600 sidebar-label">{pr.desc}</span>
        </span>
        <span class="text-[11px] text-zinc-600 group-hover/proj:text-zinc-300 sidebar-label">{pr.count}</span>
      </a>
    ))}
    <a href="/projects" class="flex w-full items-center justify-between rounded-lg px-2 py-1.5 text-[12px] text-zinc-500 hover:text-zinc-300 hover:bg-[#0a0a0a] transition-colors sidebar-label">
      <span class="flex items-center gap-1.5"><FolderIcon class="h-[12px] w-[12px]" /> View all projects</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
