---
/**
 * RecentsSection — bg black plek index, icons chevron/ellipsis/edit muncul pas hover text Recents saja
 */
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import SquarePen from '@lucide/astro/icons/square-pen';
import type { RecentItem } from '../../../lib/types/sidebar';

interface Props { items: RecentItem[]; }
const { items } = Astro.props;
---
<div data-section-wrap="recents" class="group/section bg-black">
  <div class="group/header flex h-[32px] w-full items-center justify-between bg-black px-1 rounded-md hover:bg-[#0a0a0a] transition-colors">
    <button data-section-toggle="recents" class="flex items-center gap-1 bg-black group-hover/header:bg-[#0a0a0a] text-white transition-colors">
      <span class="text-[13px] font-[600] leading-none tracking-tight sidebar-label">Recents</span>
      <ChevronDown class="h-[12px] w-[12px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-all duration-150 sidebar-label hover-reveal" data-chevron="recents" />
    </button>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="More">
        <Ellipsis class="h-[14px] w-[14px]" />
      </button>
      <button id="recents-edit" class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="Edit">
        <SquarePen class="h-[14px] w-[14px]" />
      </button>
    </div>
  </div>

  <div data-section-content="recents" class="mt-1 space-y-0.5 sidebar-section-content bg-black px-1">
    {items.length === 0 ? (
      <div id="notion-recents-list" class="space-y-0.5"><p class="px-2 py-1.5 text-[12px] text-zinc-600 sidebar-label">No recents</p></div>
    ) : (
      <div id="notion-recents-list" class="space-y-0.5">
        {items.map((n) => (
          <a href={n.url || "#"} class="group/note flex flex-col gap-0.5 rounded-lg px-2 py-2 hover:bg-[#141414] transition-colors">
            <span class="flex items-center justify-between gap-2">
              <span class="flex items-center gap-1.5 min-w-0 flex-1">
                <span class="text-[13px]">{n.icon}</span>
                <span class="truncate text-[13px] text-zinc-400 group-hover/note:text-white sidebar-label leading-tight">{n.title}</span>
              </span>
              <span class="shrink-0 rounded bg-[#1a1a1a] px-1 py-0.5 text-[10px] text-zinc-500 group-hover/note:text-zinc-300 sidebar-label">{n.tag}</span>
            </span>
            <span class="pl-[22px] text-[11px] text-zinc-600 sidebar-label">{n.time} • Notion</span>
          </a>
        ))}
      </div>
    )}
    <div class="mt-2 rounded-[10px] border border-dashed border-white/[0.06] bg-black p-2.5 text-center sidebar-label">
      <p class="text-[11px] text-zinc-600 leading-snug">Hubungkan Notion — <code class="text-zinc-500">/api/notion/recents</code></p>
      <div class="mt-2 flex justify-center gap-1.5">
        <button id="sync-notion" class="rounded-md bg-[#141414] hover:bg-[#1f1f1f] px-2.5 py-1 text-[11px] text-zinc-400 transition-colors">Sync Notion</button>
        <a href="https://notion.so" target="_blank" class="rounded-md bg-transparent border border-white/[0.08] px-2.5 py-1 text-[11px] text-zinc-600 hover:text-zinc-300 transition-colors">Open Notion</a>
      </div>
    </div>
  </div>
</div>
