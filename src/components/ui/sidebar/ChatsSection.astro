---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Ellipsis from '@lucide/astro/icons/ellipsis';
import SquarePen from '@lucide/astro/icons/square-pen';
---
<div data-section-wrap="chats" class="group/section bg-black">
  <div class="group/header flex h-[32px] w-full items-center justify-between bg-black px-1 rounded-md hover:bg-[#0a0a0a] transition-colors">
    <button data-section-toggle="chats" class="flex items-center gap-1 bg-black group-hover/header:bg-[#0a0a0a] text-white transition-colors">
      <span class="text-[13px] font-[600] leading-none tracking-tight sidebar-label">Chats</span>
      <ChevronDown class="h-[12px] w-[12px] text-white/60 opacity-0 group-hover/header:opacity-100 transition-all duration-150 sidebar-label hover-reveal" data-chevron="chats" />
    </button>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="More">
        <Ellipsis class="h-[14px] w-[14px]" />
      </button>
      <button class="flex h-6 w-6 items-center justify-center rounded-md text-white/50 hover:text-white hover:bg-[#141414] transition-colors sidebar-label hover-reveal" aria-label="Edit">
        <SquarePen class="h-[14px] w-[14px]" />
      </button>
    </div>
  </div>
  <div data-section-content="chats" class="mt-1 sidebar-section-content bg-black px-1">
    <div id="sidebar-chat-list" class="space-y-0.5"><p id="sidebar-empty" class="px-2 py-1.5 text-[12px] text-zinc-600 sidebar-label">No chats yet</p></div>
  </div>
</div>
