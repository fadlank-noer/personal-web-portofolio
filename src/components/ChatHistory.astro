---
import OpponentChat from '../integrations/preact/OpponentChat';

interface Props {
    messages: Array<{
        id: string;
        question: string;
        answer: string;
        answer_type: string;
        images: string[];
    }>;
}

const { messages = [] } = Astro.props;
---

{messages.map((msg) => (
    <div class="flex flex-col gap-4 mb-4" data-chat-history-item>
        {/* User message */}
        <div class="flex justify-end">
            <div class="bg-[#3f3f3f] text-white px-4 py-2 rounded-2xl rounded-br-md max-w-[80%]">
                <p class="text-sm">{msg.question}</p>
            </div>
        </div>

        {/* Assistant response */}
        <div class="flex justify-start">
            <OpponentChat
                client:load
                answer={msg.answer}
                images={msg.images}
                answer_type={msg.answer_type}
            />
        </div>
    </div>
))}