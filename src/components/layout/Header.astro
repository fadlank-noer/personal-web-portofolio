---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import SideToggleMobile from '../../assets/svgs/side-toggle-mobile.svg';

interface Props {
  title?: string;
}
const { title = 'FadlanGPT' } = Astro.props;
---

<header class="flex h-[52px] w-full items-center justify-between bg-black px-3 md:px-4 flex-shrink-0 shrink-0">
  <!-- Left: side-toggle-mobile.svg + FadlanGPT -->
  <div class="flex items-center gap-[6px] min-w-0">
    <button id="chatroom-sidebar-toggle" class="flex md:hidden h-9 w-9 items-center justify-center rounded-full text-white hover:bg-[#1a1a1a] transition-colors shrink-0 -ml-1" aria-label="Toggle sidebar">
      <SideToggleMobile class="h-[22px] w-[22px] text-white" />
    </button>
    <button id="fadlangpt-trademark" class="group flex items-center gap-[4px] rounded-lg px-1.5 py-1.5 text-white hover:bg-[#1a1a1a] transition-colors select-none min-w-0 max-w-[64vw] md:max-w-none">
      <span class="truncate text-[18px] font-[600] leading-none tracking-[-0.02em] font-sans antialiased">{title}</span>
      <ChevronDown class="h-[16px] w-[16px] shrink-0 text-zinc-400 group-hover:text-zinc-200 transition-colors mt-[2px]" />
    </button>
  </div>
  <!-- Right intentionally empty — circular logo removed per request -->
  <div class="hidden md:flex items-center"></div>
</header>

<script>
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const toggle = document.getElementById('chatroom-sidebar-toggle');
  const trademark = document.getElementById('fadlangpt-trademark');
  const isMobile = () => window.innerWidth < 768;
  const applyMobile = (open) => {
    if (!sidebar || !overlay) return;
    sidebar.dataset.mobileOpen = open ? 'true' : 'false';
    overlay.classList.toggle('hidden', !open);
  };
  toggle?.addEventListener('click', () => {
    if (!sidebar) return;
    const cur = sidebar.dataset.mobileOpen === 'true';
    applyMobile(!cur);
  });
  trademark?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('fadlangpt:trademark-click'));
  });
  window.addEventListener('resize', () => {
    if (!isMobile() && sidebar && overlay) {
      sidebar.dataset.mobileOpen = 'false';
      overlay.classList.add('hidden');
    }
  });
</script>
