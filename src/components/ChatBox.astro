---
import Plus from '@lucide/astro/icons/plus';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Mic from '../assets/svgs/mic.svg';
import SpeakWave from '../assets/svgs/speak-wave.svg';
import ChatHistory from './ChatHistory.astro';
import questionsData from '../data/question-templates.json';

const { cn = "" } = Astro.props;
---

<style>
    .chat-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .chat-scrollbar::-webkit-scrollbar-track {
        background: #2f2f2f;
        border-radius: 3px;
    }
    .chat-scrollbar::-webkit-scrollbar-thumb {
        background: #555;
        border-radius: 3px;
    }
    .chat-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #777;
    }
</style>

<div id="chat-container" class:list={["flex flex-col items-center justify-center w-full flex-1 min-h-0", cn]}>
    <div class="flex flex-col items-center max-w-2xl w-full">
        {/* Header - before chat */}
        <h1 id="chat-header" class="text-2xl text-center w-full mb-6">Mind to know me better?</h1>

        {/* Disclaimer - after chat */}
        <p id="chat-disclaimer" class="text-xs text-gray-500 text-center mt-2 my-2 hidden">
            ChatGPT can make mistakes. I can fix that.
        </p>

        {/* Input bar */}
        <div
            id="input-wrapper"
            class="w-full bg-[#2f2f2f] rounded-3xl px-4 py-3 my-2 flex items-end gap-2"
        >
            <textarea
                id="chat-input"
                placeholder="Ask anything"
                rows="1"
                class="w-full bg-transparent text-white placeholder-gray-400 outline-none text-sm resize-none overflow-y-auto min-h-[24px] max-h-[200px] chat-scrollbar order-2"
            ></textarea>

            <div id="bottom-row" class="contents">
                <div id="plus-wrap" class="flex-shrink-0 order-1">
                    <button id="add-btn-main" class="p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                        <Plus class="w-5 h-5 text-gray-300" />
                    </button>
                </div>
                <div id="icons-wrap" class="flex items-center gap-2 flex-shrink-0 order-3">
                    <button id="mic-btn" class="p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                        <Mic class="w-5 h-5 text-gray-300" />
                    </button>
                    <button id="send-btn" class="p-1.5 rounded-full transition-colors bg-white hover:bg-[--primary-color]">
                        <SpeakWave id="send-icon-default" class="w-5 h-5 text-black" />
                        <ArrowUp id="send-icon-active" class="w-5 h-5 text-black hidden" />
                    </button>
                </div>
            </div>
        </div>

        {/* Wrapped state container (hidden by default) */}
        <div id="wrapped-wrapper" class="w-full hidden">
            <div class="flex flex-col gap-2">
                {/* Plus button centered with space around */}
                <div class="flex items-start py-1">
                    <button class="p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                        <Plus class="w-5 h-5 text-gray-300" />
                    </button>
                </div>
                {/* Input row */}
                <div class="flex items-end gap-2">
                    <textarea
                        id="chat-input-wrapped"
                        placeholder="Ask anything"
                        rows="1"
                        class="w-full bg-transparent text-white placeholder-gray-400 outline-none text-sm resize-none overflow-y-auto min-h-[24px] max-h-[200px] chat-scrollbar"
                    ></textarea>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <button class="p-1.5 rounded-full hover:bg-[#424242] transition-colors">
                            <Mic class="w-5 h-5 text-gray-300" />
                        </button>
                        <button class="p-1.5 rounded-full transition-colors bg-white hover:bg-[--primary-color]">
                            <ArrowUp class="w-5 h-5 text-black" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script define:vars={{ questions: questionsData.questions }}>
    const container = document.getElementById('chat-container');
    const header = document.getElementById('chat-header');
    const disclaimer = document.getElementById('chat-disclaimer');
    const inputWrapper = document.getElementById('input-wrapper');
    const wrappedWrapper = document.getElementById('wrapped-wrapper');
    const input = document.getElementById('chat-input');
    const inputWrapped = document.getElementById('chat-input-wrapped');
    const sendBtn = document.getElementById('send-btn');
    const sendIconDefault = document.getElementById('send-icon-default');
    const sendIconActive = document.getElementById('send-icon-active');
    const addBtnMain = document.getElementById('add-btn-main');
    const micBtn = document.getElementById('mic-btn');

    let isChatted = false;

    function resizeTextarea(textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
    }

    function checkTextWrap() {
        const value = input.value;
        const totalChars = value.length;
        const CHARS_PER_LINE = 74;
        const MAX_VISIBLE_LINES = 9;
        
        const lineCount = Math.ceil(totalChars / CHARS_PER_LINE);
        const isMultiLine = totalChars > CHARS_PER_LINE;
        const needsScroll = lineCount > MAX_VISIBLE_LINES;
        
        const bottomRow = document.getElementById('bottom-row');
        const plusWrap = document.getElementById('plus-wrap');
        const iconsWrap = document.getElementById('icons-wrap');
        
        if (isMultiLine) {
            // Multi-line: textarea on top, bottom row below with justify-between
            inputWrapper.classList.remove('items-end');
            inputWrapper.classList.add('flex-wrap');
            input.classList.add('basis-full');
            bottomRow.classList.remove('contents');
            bottomRow.classList.add('flex', 'items-center', 'justify-between', 'w-full');
            input.classList.remove('order-2');
            plusWrap.classList.remove('order-1');
            iconsWrap.classList.remove('order-3');
        } else {
            // Single-line: all in one row via display:contents
            inputWrapper.classList.remove('flex-wrap');
            inputWrapper.classList.add('items-end');
            input.classList.remove('basis-full');
            bottomRow.classList.remove('flex', 'items-center', 'justify-between', 'w-full');
            bottomRow.classList.add('contents');
            input.classList.add('order-2');
            plusWrap.classList.add('order-1');
            iconsWrap.classList.add('order-3');
        }

        if (needsScroll) {
            inputWrapper.classList.add('max-h-[300px]', 'overflow-y-auto');
        } else {
            inputWrapper.classList.remove('max-h-[300px]', 'overflow-y-auto');
        }
    }

    function submit() {
        const value = input.value.trim();
        if (!value) return;

        isChatted = true;
        header.classList.add('hidden');
        disclaimer.classList.remove('hidden');
        
        // Find matching answer
        const matched = questions.find(q => 
            value.toLowerCase().includes(q.question.toLowerCase()) ||
            q.question.toLowerCase().includes(value.toLowerCase())
        );
        
        const answer = matched ? matched.answer : "I'm sorry, I don't have an answer for that question yet. Try asking about me!";
        
        console.log('Question:', value);
        console.log('Answer:', answer);
        
        input.value = '';
        resizeTextarea(input);
    }

    // Event listeners
    input.addEventListener('input', () => {
        resizeTextarea(input);
        checkTextWrap();
        
        // Toggle send icons
        if (input.value.trim()) {
            sendIconDefault.classList.add('hidden');
            sendIconActive.classList.remove('hidden');
        } else {
            sendIconDefault.classList.remove('hidden');
            sendIconActive.classList.add('hidden');
        }
    });

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            submit();
        }
    });

    sendBtn.addEventListener('click', submit);

    // Initial resize
    resizeTextarea(input);
</script>