---
import Plus from '@lucide/astro/icons/plus';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Mic from '../assets/svgs/mic.svg';
import SpeakWave from '../assets/svgs/speak-wave.svg';
import questionsData from '../data/question-templates.json';

const { cn = "" } = Astro.props;
---

<style>
  .chat-scrollbar::-webkit-scrollbar { width: 6px; }
  .chat-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .chat-scrollbar::-webkit-scrollbar-thumb { background: #3a3a3a; border-radius: 3px; }
  .chat-scrollbar::-webkit-scrollbar-thumb:hover { background: #555; }

  .suggestion-enter { animation: slideUp 0.18s ease-out; }
  @keyframes slideUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>

<!-- 
  ChatBox — GPT-like input bar
  Posisi: sticky bottom DI BAWAH ChatHistory
  Logic: query ke questions json, hanya bisa submit yang ada di json, history via nanostores localStorage
-->
<div id="chatbox-container" class:list={["w-full flex-shrink-0 bg-gradient-to-t from-black via-black to-transparent", cn]}>
  <div class="mx-auto w-full max-w-[48rem] px-4 pb-6 pt-2">
    <!-- Autocomplete dropdown - di ATAS input -->
    <div id="autocomplete-list" class="hidden absolute bottom-full mb-2 w-full left-0 right-0 rounded-2xl bg-[#212121] border border-[#2f2f2f] shadow-2xl overflow-hidden z-10 suggestion-enter max-h-64 overflow-y-auto chat-scrollbar">
    </div>

    <div class="relative w-full">
      <!-- Helper -->
      <p id="input-helper" class="hidden text-[12px] text-amber-400/80 px-3 pb-2">Please select from suggestions — only questions from list are allowed.</p>

      <!-- Input bar - GPT-like rounded-[28px] -->
      <div
        id="input-wrapper"
        class="w-full bg-[#2f2f2f] rounded-[28px] px-4 py-3 flex items-end gap-2 transition-colors focus-within:bg-[#303030] border border-transparent focus-within:border-[#3a3a3a]"
      >
        <textarea
          id="chat-input"
          placeholder="Ask anything"
          rows="1"
          class="w-full bg-transparent text-white placeholder-zinc-400 outline-none text-[15px] leading-[24px] resize-none overflow-y-auto min-h-[24px] max-h-[200px] chat-scrollbar order-2"
        ></textarea>
        <div id="bottom-row" class="contents">
          <div id="plus-wrap" class="flex-shrink-0 order-1">
            <button id="add-btn-main" class="p-1.5 rounded-full hover:bg-[#424242] transition-colors" type="button" aria-label="Add">
              <Plus class="w-5 h-5 text-zinc-300" />
            </button>
          </div>
          <div id="icons-wrap" class="flex items-center gap-2 flex-shrink-0 order-3">
            <button id="mic-btn" class="p-1.5 rounded-full hover:bg-[#424242] transition-colors" type="button" aria-label="Voice">
              <Mic class="w-5 h-5 text-zinc-300" />
            </button>
            <button id="send-btn" class="p-2 rounded-full transition-all bg-zinc-600 opacity-40 disabled:cursor-not-allowed" type="button" aria-label="Send" disabled>
              <SpeakWave id="send-icon-default" class="w-5 h-5 text-black" />
              <ArrowUp id="send-icon-active" class="w-5 h-5 text-black hidden" />
            </button>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-3 text-center text-[11px] leading-4 text-zinc-500">
      FadlanGPT can make mistakes. Check important info.
    </p>
  </div>
</div>

<script define:vars={{ questions: questionsData.questions }}>
  const STORAGE_KEY = 'fadlan-chat-history';

  const inputWrapper = document.getElementById('input-wrapper');
  const input = document.getElementById('chat-input');
  const autoList = document.getElementById('autocomplete-list');
  const inputHelper = document.getElementById('input-helper');
  const sendBtn = document.getElementById('send-btn');
  const sendIconDefault = document.getElementById('send-icon-default');
  const sendIconActive = document.getElementById('send-icon-active');

  let filteredSuggestions = [];
  let selectedIndex = -1;

  function generateId() { return `msg_${Date.now()}_${Math.random().toString(36).slice(2,9)}`; }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function filterQuestions(query, limit = 6) {
    if (!query || query.trim().length < 1) return [];
    const q = query.toLowerCase().trim();
    const scored = questions.map(qt => {
      const lq = qt.question.toLowerCase();
      let score = 0;
      if (lq === q) score = 100;
      else if (lq.startsWith(q)) score = 80;
      else if (lq.includes(q)) score = 60;
      else {
        const words = q.split(/\s+/).filter(Boolean);
        const matches = words.filter(w => lq.includes(w)).length;
        if (matches > 0) score = (matches / words.length) * 50;
      }
      return { qt, score };
    }).filter(({score}) => score > 0).sort((a,b) => b.score - a.score).slice(0, limit).map(({qt}) => qt);
    return scored;
  }

  function findExactQuestion(query) {
    const q = (query||'').toLowerCase().trim();
    if (!q) return null;
    const exact = questions.find(i => i.question.toLowerCase().trim() === q);
    if (exact) return exact;
    // user requirement: only valid if exists in json - allow flexible contains if long enough
    const loose = questions.find(i => {
      const lq = i.question.toLowerCase();
      return lq.includes(q) || q.includes(lq);
    });
    return loose ?? null;
  }

  function isValidQuestion(query) {
    return !!findExactQuestion(query);
  }

  function renderAutocomplete() {
    if (filteredSuggestions.length === 0) {
      autoList.classList.add('hidden');
      return;
    }
    autoList.innerHTML = filteredSuggestions.map((item, idx) => {
      const active = idx === selectedIndex ? 'bg-[#3a3a3a] text-white' : 'text-zinc-300 hover:bg-[#2a2a2a]';
      return `<button type="button" data-suggest-idx="${idx}" class="w-full text-left px-4 py-3 text-[14px] leading-snug transition-colors ${active} border-b border-[#2a2a2a] last:border-0">${escapeHtml(item.question)}</button>`;
    }).join('');
    autoList.classList.remove('hidden');

    autoList.querySelectorAll('[data-suggest-idx]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-suggest-idx'), 10);
        selectSuggestion(idx);
      });
    });
  }

  function selectSuggestion(idx) {
    if (idx < 0 || idx >= filteredSuggestions.length) return;
    const q = filteredSuggestions[idx];
    input.value = q.question;
    resizeTextarea(input);
    closeAutocomplete();
    validateInput();
    input.focus();
  }

  function closeAutocomplete() {
    autoList.classList.add('hidden');
    selectedIndex = -1;
    filteredSuggestions = [];
  }

  function validateInput() {
    const value = input.value.trim();
    if (value === '') {
      sendBtn.disabled = true;
      sendBtn.classList.add('bg-zinc-600', 'opacity-40');
      sendBtn.classList.remove('bg-white', 'opacity-100');
      sendIconDefault.classList.remove('hidden');
      sendIconActive.classList.add('hidden');
      inputHelper.classList.add('hidden');
      return false;
    }
    const valid = isValidQuestion(value);
    if (valid) {
      sendBtn.disabled = false;
      sendBtn.classList.remove('bg-zinc-600', 'opacity-40');
      sendBtn.classList.add('bg-white', 'opacity-100');
      sendIconDefault.classList.add('hidden');
      sendIconActive.classList.remove('hidden');
      inputHelper.classList.add('hidden');
      return true;
    } else {
      sendBtn.disabled = true;
      sendBtn.classList.add('bg-zinc-600', 'opacity-40');
      sendBtn.classList.remove('bg-white', 'opacity-100');
      sendIconDefault.classList.remove('hidden');
      sendIconActive.classList.add('hidden');
      if (value.length >= 2) inputHelper.classList.remove('hidden');
      return false;
    }
  }

  function resizeTextarea(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
  }

  function checkTextWrap() {
    const value = input.value;
    const CHARS_PER_LINE = 74;
    const MAX_VISIBLE_LINES = 9;
    const totalChars = value.length;
    const lineCount = Math.ceil(totalChars / CHARS_PER_LINE);
    const isMultiLine = totalChars > CHARS_PER_LINE;
    const needsScroll = lineCount > MAX_VISIBLE_LINES;
    const bottomRow = document.getElementById('bottom-row');
    const plusWrap = document.getElementById('plus-wrap');
    const iconsWrap = document.getElementById('icons-wrap');

    if (isMultiLine) {
      inputWrapper.classList.remove('items-end');
      inputWrapper.classList.add('flex-wrap');
      input.classList.add('basis-full');
      bottomRow.classList.remove('contents');
      bottomRow.classList.add('flex','items-center','justify-between','w-full');
      input.classList.remove('order-2');
      plusWrap.classList.remove('order-1');
      iconsWrap.classList.remove('order-3');
    } else {
      inputWrapper.classList.remove('flex-wrap');
      inputWrapper.classList.add('items-end');
      input.classList.remove('basis-full');
      bottomRow.classList.remove('flex','items-center','justify-between','w-full');
      bottomRow.classList.add('contents');
      input.classList.add('order-2');
      plusWrap.classList.add('order-1');
      iconsWrap.classList.add('order-3');
    }

    if (needsScroll) inputWrapper.classList.add('max-h-[300px]','overflow-y-auto');
    else inputWrapper.classList.remove('max-h-[300px]','overflow-y-auto');
  }

  function submit() {
    const value = input.value.trim();
    if (!value) return;
    if (!isValidQuestion(value)) {
      inputHelper.classList.remove('hidden');
      inputWrapper.classList.add('ring-1', 'ring-amber-500/50');
      setTimeout(() => inputWrapper.classList.remove('ring-1', 'ring-amber-500/50'), 600);
      return;
    }
    const matched = findExactQuestion(value);
    if (!matched) return;

    const newMessage = {
      id: generateId(),
      question: matched.question,
      answer: matched.answer,
      answer_type: matched.answer_type,
      images: matched.images || [],
      timestamp: Date.now()
    };

    // Use ChatHistory API (nanostores via localStorage)
    const api = window.chatHistoryApi;
    if (api) {
      api.add(newMessage);
      // typing then done
      api.showTyping(true);
      setTimeout(() => {
        api.showTyping(false);
        api.scrollToBottom();
      }, 450 + Math.random()*400);
    } else {
      // fallback direct localStorage
      let history = [];
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) history = JSON.parse(raw);
      } catch {}
      history = [...history, newMessage];
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(history)); } catch {}
      window.dispatchEvent(new CustomEvent('chat:updated'));
    }

    input.value = '';
    resizeTextarea(input);
    checkTextWrap();
    validateInput();
    closeAutocomplete();
  }

  // Events
  input.addEventListener('input', () => {
    const value = input.value;
    resizeTextarea(input);
    checkTextWrap();
    validateInput();

    if (value.trim().length >= 1) {
      filteredSuggestions = filterQuestions(value);
      selectedIndex = -1;
      renderAutocomplete();
      // helper
      if (value.trim().length >= 2 && !isValidQuestion(value)) inputHelper.classList.remove('hidden');
      else if (isValidQuestion(value)) inputHelper.classList.add('hidden');
    } else {
      closeAutocomplete();
      inputHelper.classList.add('hidden');
    }
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      if (filteredSuggestions.length > 0) {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, filteredSuggestions.length - 1);
        renderAutocomplete();
        // scroll into view
        const activeBtn = autoList.querySelector(`[data-suggest-idx="${selectedIndex}"]`);
        if (activeBtn) activeBtn.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'ArrowUp') {
      if (filteredSuggestions.length > 0) {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderAutocomplete();
        const activeBtn = autoList.querySelector(`[data-suggest-idx="${selectedIndex}"]`);
        if (activeBtn) activeBtn.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'Enter') {
      if (filteredSuggestions.length > 0 && selectedIndex >= 0) {
        e.preventDefault();
        selectSuggestion(selectedIndex);
        return;
      }
      if (!e.shiftKey) {
        e.preventDefault();
        submit();
      }
    } else if (e.key === 'Escape') {
      closeAutocomplete();
      inputHelper.classList.add('hidden');
    }
  });

  // Click outside to close autocomplete
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!autoList.contains(target) && target !== input && !inputWrapper.contains(target)) {
      closeAutocomplete();
    }
  });

  sendBtn.addEventListener('click', () => submit());

  // Listen to chip clicks from ChatHistory
  window.addEventListener('chat:chip-click', (e) => {
    const q = e.detail && e.detail.question;
    if (!q) return;
    input.value = q;
    resizeTextarea(input);
    validateInput();
    submit();
  });

  // Listen to mobile toggle focus
  input.addEventListener('focus', () => {
    // on mobile, maybe close sidebar
  });

  // Init
  resizeTextarea(input);
  validateInput();
</script>
