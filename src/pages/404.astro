---
Astro.response.status = 404;
import "../styles/global.css";
import Head from "../components/Head.astro";

const top = [
  ["Champions League top scorers","Erstelle einen Content-Kalender für TikTok","챔피언스리그 하이라이트","बरसात में मजेदार चीजें","Buenos sitios con mesas al aire libre"],
  ["How come orange juice prices dropped?","Aide-moi à rédiger un e-mail de suivi","Erstelle eine Morgenroutine","Escribe un mensaje para invitar a María","インドネシアのバティックの歴史"],
  ["Membuat kalender konten TikTok","휴대폰 사진 복구 방법","Ayúdame a redactar correo de seguimiento","Planifier un voyage au Japon","Write a follow-up email after interview"],
];
const bottom = [
  ["Fadlan — Fullstack Engineer Jakarta","Develop • Design • Deploy","Astro • Tailwind • nanostores","Portfolio 2026","Build fast ↗"],
  ["What are your skills?","What projects have you built?","Bagaimana hubungi Fadlan?","Experience timeline","/about /projects /contact"],
  ["Über mich — Projekte","Mon expérience — projets","포트폴리오 프로젝트","UI/UX • Frontend • Product","Jakarta Selatan — Remote okay"],
];
const x3 = (a:string[])=>[...a,...a,...a];
---
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<Head />
<title>404 — Page not found | FadlanGPT</title>
<meta name="robots" content="noindex" />
</head>
<body class="bg-black text-white antialiased overflow-hidden">
<main class="relative flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden bg-[#050505] selection:bg-white selection:text-black">
<!-- grid + vignette -->
<div class="pointer-events-none absolute inset-0 z-0">
<div class="absolute inset-0 bg-[linear-gradient(to_right,#1a1a1a_1px,transparent_1px),linear-gradient(to_bottom,#1a1a1a_1px,transparent_1px)] bg-[size:40px_40px] opacity-[0.12]"></div>
<div class="absolute inset-0 bg-gradient-to-b from-black via-black/20 to-black"></div>
<div class="absolute inset-0 bg-gradient-to-r from-black via-transparent to-black"></div>
</div>

<!-- bg prompts — ChatGPT 404 style -->
<div class="pointer-events-none absolute inset-0 z-[1] flex flex-col justify-center gap-2.5 py-4 md:gap-3 overflow-hidden select-none">
<div class="absolute inset-x-0 top-0 z-10 h-20 bg-gradient-to-b from-black to-transparent"></div>
<div class="absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-black to-transparent"></div>
<div class="absolute inset-0 z-10" style="mask-image:linear-gradient(to right,transparent,black 7%,black 93%,transparent);-webkit-mask-image:linear-gradient(to right,transparent,black 7%,black 93%,transparent)"></div>

<div class="flex flex-col gap-2.5 md:gap-3">
{top.map((r,i)=>(
<div class="relative w-full overflow-hidden"><div class={`marq flex w-max gap-2.5 ${i%2?'mr':'ml'} d${[40,55,48][i]}`}>{x3(r).map(t=><div class="box"><span class="truncate">{t}</span><span class="ico">↗</span></div>)}</div></div>
))}
</div>

<div class="h-[30vh] md:h-[34vh] shrink-0"></div>

<div class="flex flex-col gap-2.5 md:gap-3">
{bottom.map((r,i)=>(
<div class="relative w-full overflow-hidden"><div class={`marq flex w-max gap-2.5 ${i%2?'ml':'mr'} d${[38,60,44][i]}`}>{x3(r).map(t=><div class="box"><span class="truncate">{t}</span><span class="ico">↗</span></div>)}</div></div>
))}
</div>
</div>

<!-- center -->
<div class="relative z-20 flex w-full flex-col items-center px-4 py-10 text-center md:px-6">
<div class="in flex flex-col items-center">
<h1 class="t404 font-[800] leading-[0.85] tracking-[-0.08em] text-white select-none">404</h1>
<p class="mt-4 text-[18px] font-medium tracking-tight text-white md:text-[20px] md:font-semibold">Page not found</p>
<div class="mt-6 flex flex-wrap items-center justify-center gap-3">
<a href="/" class="rounded-full bg-white px-6 py-2.5 text-[14px] font-semibold text-black hover:bg-zinc-100 active:scale-[0.98] md:px-7 md:py-[11px] md:text-[15px]">Back to Home</a>
<button id="back" class="rounded-full border border-white/15 bg-white/[0.06] px-6 py-2.5 text-[14px] font-medium text-zinc-200 backdrop-blur hover:bg-white/[0.1] active:scale-[0.98] md:px-7 md:py-[11px]">Go Back</button>
</div>
<p class="mt-6 max-w-[28ch] text-balance text-[12px] leading-5 text-zinc-500 md:text-[13px]">
<span class="rounded border border-white/10 bg-white/[0.06] px-1.5 py-0.5 font-mono text-zinc-400">{Astro.url.pathname}</span> doesn't exist.
</p>
</div>
</div>

<div class="pointer-events-none absolute bottom-0 left-0 right-0 z-20 flex justify-center pb-[env(safe-area-inset-bottom)]">
<div class="mb-3 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-[10px] text-zinc-500 backdrop-blur md:hidden">FadlanGPT • static • SPA</div>
</div>

<style>
.t404{font-size:clamp(84px,28vw,200px);font-weight:800;line-height:.85;letter-spacing:-.08em;text-rendering:geometricPrecision}
.in{animation:in .7s cubic-bezier(.16,1,.3,1) both}
@keyframes in{from{opacity:0;transform:translateY(16px) scale(.98);filter:blur(8px)}to{opacity:1;transform:none;filter:none}}

.box{display:inline-flex;align-items:center;justify-content:space-between;gap:10px;min-width:200px;max-width:min(420px,78vw);padding:11px 14px 11px 16px;border-radius:14px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);backdrop-filter:blur(6px);color:rgba(255,255,255,.4);font-size:13px;line-height:1.35;white-space:nowrap}
.ico{display:flex;h:20px;w:20px;flex-shrink:0;height:20px;width:20px;align-items:center;justify-content:center;border-radius:9999px;background:rgba(255,255,255,.1);font-size:12px;line-height:1}
.marq{animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform}
.ml{animation-name:ml} .mr{animation-name:mr}
@keyframes ml{0%{transform:translateX(0)}100%{transform:translateX(-33.333%)}}
@keyframes mr{0%{transform:translateX(-33.333%)}100%{transform:translateX(0)}}
.d38{animation-duration:38s}.d40{animation-duration:40s}.d44{animation-duration:44s}.d48{animation-duration:48s}.d55{animation-duration:55s}.d60{animation-duration:60s}
@media(max-width:768px){
.box{min-width:160px;max-width:70vw;padding:10px 12px 10px 14px;font-size:12px;border-radius:12px}
.t404{font-size:clamp(72px,26vw,140px)}
.d38{animation-duration:28s}.d40{animation-duration:30s}.d44{animation-duration:32s}.d48{animation-duration:36s}.d55{animation-duration:40s}.d60{animation-duration:44s}
}
@media(prefers-reduced-motion:reduce){.in{animation:none}.marq{animation:none}}
</style>
</main>
<script>
document.getElementById('back')?.addEventListener('click',e=>{
e.preventDefault();
history.length>1?history.back():location.href='/';
});
</script>
</body>
</html>
