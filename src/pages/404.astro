---
Astro.response.status = 404;
// 404 - 3 rows top moving right, 3 rows bottom moving left - blok kotak
const topRows = [
  ["ABOUT", "SKILLS", "PROJECTS", "EXPERIENCE", "CONTACT", "RESUME", "BLOG", "GITHUB", "LINKEDIN", "DESIGN"],
  ["404", "NOT FOUND", "ERROR", "LOST", "MISSING", "404", "NOT FOUND", "VOID", "NULL", "404"],
  ["Astro", "TypeScript", "React", "Tailwind", "Figma", "Vercel", "Node.js", "Alpine.js", "GPT", "Build"],
];

const bottomRows = [
  ["DEVELOP", "DESIGN", "DEPLOY", "DEBUG", "SHIP", "CODE", "CREATE", "BUILD", "LAUNCH", "ITERATE"],
  ["PAGE NOT FOUND", "GO BACK", "HOME", "404", "MISSING", "LOST PATH", "404", "NOT HERE", "GO HOME", "404"],
  ["Fadlan", "Portfolio", "2026", "Jakarta", "Frontend", "Engineer", "UI/UX", "Product", "Craft", "Studio"],
];

// triple for seamless infinite (need > 2x viewport width)
const triple = (arr: string[]) => [...arr, ...arr, ...arr];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Page not found | Fadlan</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden bg-black text-white antialiased selection:bg-white selection:text-black">
      <!-- Grid bg subtle -->
      <div class="pointer-events-none absolute inset-0 z-0">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#1a1a1a_1px,transparent_1px),linear-gradient(to_bottom,#1a1a1a_1px,transparent_1px)] bg-[size:48px_48px] opacity-[0.25]"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black"></div>
      </div>

      <!-- TOP: 3 rows -> gerak ke KANAN -->
      <div class="absolute top-0 left-0 z-0 w-full overflow-hidden py-3 md:py-4 flex flex-col gap-3 select-none pointer-events-none">
        <!-- mask fade left/right -->
        <div class="absolute inset-0 z-10 pointer-events-none" style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent)"></div>
        
        {topRows.map((row, idx) => (
          <div class="relative w-full overflow-hidden">
            <div class={`marquee-row marquee-right flex w-max gap-3 will-change-transform ${idx === 0 ? 'speed-1' : idx === 1 ? 'speed-2' : 'speed-3'}`}>
              {triple(row).map((text, i) => (
                <div class={`box-block ${idx === 1 && text === "404" ? "box-accent" : ""} ${i % 7 === 0 ? "box-filled" : ""}`}>
                  <span class="dot"></span>
                  <span>{text}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- CENTER CONTENT -->
      <div class="relative z-20 flex flex-col items-center px-6 py-20 text-center">
        <div class="fade-in flex flex-col items-center">
          <!-- 404 big -->
          <div class="relative">
            <h1 class="text-404 font-black leading-[0.85] tracking-[-0.08em] text-white select-none">
              404
            </h1>
            <!-- glow -->
            <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[220px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/-[0.04] blur-[60px]"></div>
            <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[120px] w-[260px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10 blur-[40px] opacity-60"></div>
          </div>

          <div class="mt-6 flex flex-col items-center gap-3">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[11px] font-medium tracking-widest text-white/50">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-400"></span>
              PAGE NOT FOUND
            </div>
            <p class="max-w-[32ch] text-balance text-[15px] leading-6 text-zinc-400 md:text-[16px]">
              The page you are looking for doesn't exist or has been moved.
              Looks like you're lost in the void.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/"
              class="group inline-flex items-center gap-2 rounded-full bg-white px-6 py-[11px] text-[14px] font-semibold text-black transition-all hover:bg-zinc-200 active:scale-[0.98]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:-translate-x-0.5"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
              Back to Home
            </a>
            <button
              onclick="history.back()"
              class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-6 py-[11px] text-[14px] font-medium text-zinc-300 backdrop-blur transition-colors hover:bg-white/[0.06] hover:text-white hover:border-white/20"
            >
              Go Back
            </button>
          </div>

          <!-- suggestion boxes like blok -->
          <div class="mt-10 flex flex-wrap justify-center gap-2 opacity-60">
            <span class="rounded-lg border border-white/10 bg-white/[0.02] px-2.5 py-1 text-[11px] text-zinc-500">/about</span>
            <span class="rounded-lg border border-white/10 bg-white/[0.02] px-2.5 py-1 text-[11px] text-zinc-500">/projects</span>
            <span class="rounded-lg border border-white/10 bg-white/[0.02] px-2.5 py-1 text-[11px] text-zinc-500">/contact</span>
          </div>
        </div>
      </div>

      <!-- BOTTOM: 3 rows -> gerak ke KIRI -->
      <div class="absolute bottom-0 left-0 z-0 w-full overflow-hidden py-3 md:py-4 flex flex-col gap-3 select-none pointer-events-none">
        <div class="absolute inset-0 z-10 pointer-events-none" style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent)"></div>

        {bottomRows.map((row, idx) => (
          <div class="relative w-full overflow-hidden">
            <div class={`marquee-row marquee-left flex w-max gap-3 will-change-transform ${idx === 0 ? 'speed-4' : idx === 1 ? 'speed-5' : 'speed-6'}`}>
              {triple(row).map((text, i) => (
                <div class={`box-block ${idx === 1 && (text.includes("404") || text === "HOME") ? "box-accent" : ""} ${i % 5 === 0 ? "box-filled" : ""}`}>
                  <span class="dot"></span>
                  <span>{text}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <style>
        .text-404 {
          font-size: clamp(96px, 22vw, 200px);
          font-weight: 900;
          line-height: 0.85;
          letter-spacing: -0.08em;
          text-rendering: geometricPrecision;
        }

        .fade-in {
          animation: fadeIn 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(16px) scale(0.98); filter: blur(8px); }
          to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }

        /* Box blok kotak */
        .box-block {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 10px 16px;
          border-radius: 10px;
          border: 1px solid rgba(255,255,255,0.08);
          background: rgba(255,255,255,0.03);
          backdrop-filter: blur(4px);
          color: rgba(255,255,255,0.45);
          font-size: 13px;
          font-weight: 500;
          letter-spacing: 0.02em;
          line-height: 1;
          white-space: nowrap;
          user-select: none;
          transition: border-color 0.2s, background 0.2s;
        }
        .box-block .dot {
          width: 6px;
          height: 6px;
          border-radius: 9999px;
          background: rgba(255,255,255,0.2);
          flex-shrink: 0;
        }
        .box-filled {
          background: rgba(255,255,255,0.06);
          border-color: rgba(255,255,255,0.12);
          color: rgba(255,255,255,0.7);
        }
        .box-filled .dot { background: rgba(255,255,255,0.5); }
        .box-accent {
          background: rgba(255,255,255,0.9);
          border-color: white;
          color: black;
          font-weight: 700;
        }
        .box-accent .dot { background: black; }

        /* Marquee core */
        .marquee-row {
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }
        .marquee-right {
          animation-name: marqueeRight;
        }
        .marquee-left {
          animation-name: marqueeLeft;
        }

        @keyframes marqueeRight {
          0% { transform: translateX(-33.333%); }
          100% { transform: translateX(0%); }
        }
        @keyframes marqueeLeft {
          0% { transform: translateX(0%); }
          100% { transform: translateX(-33.333%); }
        }

        /* Varied speeds for 3+3 rows */
        .speed-1 { animation-duration: 28s; }
        .speed-2 { animation-duration: 42s; }
        .speed-3 { animation-duration: 36s; }
        .speed-4 { animation-duration: 32s; }
        .speed-5 { animation-duration: 48s; }
        .speed-6 { animation-duration: 26s; }

        /* pause on hover of main (optional, removed pointer-events but for a11y) */
        /* .marquee-row:hover { animation-play-state: paused; } */

        @media (max-width: 768px) {
          .box-block { padding: 8px 12px; font-size: 11.5px; border-radius: 8px; }
          .speed-1 { animation-duration: 22s; }
          .speed-2 { animation-duration: 34s; }
          .speed-3 { animation-duration: 28s; }
          .speed-4 { animation-duration: 26s; }
          .speed-5 { animation-duration: 38s; }
          .speed-6 { animation-duration: 20s; }
        }

        @media (prefers-reduced-motion: reduce) {
          .fade-in { animation: none; opacity: 1; transform: none; filter: none; }
          .marquee-row { animation: none; transform: translateX(0) !important; }
        }
      </style>
    </main>

    <script>
      // SPA improvement: if user lands on 404 directly, ensure back button works even without history
      // Also prevent caching issues on Vercel
      if (window.history.length <= 1) {
        const backBtn = document.querySelector('button[onclick="history.back()"]');
        if (backBtn) {
          // hide or change behavior if no history
          backBtn.addEventListener('click', (e) => {
            e.preventDefault();
            window.location.href = '/';
          });
        }
      }
    </script>
  </body>
</html>
