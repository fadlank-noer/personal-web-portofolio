---
Astro.response.status = 404;
import "../styles/global.css";
import Head from "../layouts/Head.astro";

// Top groups: flowing prompts above 404, anchored to top via space-between
const top = [
  [
    "Champions League top scorers",
    "Erstelle einen Content-Kalender für TikTok",
    "챔피언스리그 하이라이트",
    "बरसात में मजेदार चीजें",
    "Buenos sitios con mesas al aire libre",
  ],
  [
    "How come orange juice prices dropped?",
    "Aide-moi à rédiger un e-mail de suivi",
    "Erstelle eine Morgenroutine",
    "Escribe un mensaje para invitar a María",
    "インドネシアのバティックの歴史",
  ],
  [
    "Membuat kalender konten TikTok",
    "휴대폰 사진 복구 방법",
    "Ayúdame a redactar correo de seguimiento",
    "Planifier un voyage au Japon",
    "Write a follow-up email after interview",
  ],
];

// Bottom groups: portfolio keywords, anchored to bottom via space-between
const bottom = [
  ["Fadlan — Fullstack Engineer Jakarta", "Develop • Design • Deploy", "Astro • Tailwind • nanostores", "Portfolio 2026", "Build fast ↗"],
  ["What are your skills?", "What projects have you built?", "Bagaimana hubungi Fadlan?", "Experience timeline", "/about /projects /contact"],
  ["Über mich — Projekte", "Mon expérience — projets", "포트폴리오 프로젝트", "UI/UX • Frontend • Product", "Jakarta Selatan — Remote okay"],
];

// Triple for seamless marquee loop
const x3 = (a: string[]) => [...a, ...a, ...a];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Head />
    <title>404 — Page not found | FadlanGPT</title>
    <meta name="robots" content="noindex" />
  </head>

  <body class="bg-black text-white antialiased overflow-hidden">
    <main
      class="relative flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden bg-[#050505] selection:bg-white selection:text-black"
    >
      <!-- =======================================================
           Background grid + vignette
           ======================================================= -->
      <div class="pointer-events-none absolute inset-0 z-0">
          <!-- Radial vignette: adds depth on large screens without a grid -->
          <div
            class="absolute inset-0"
            style="background: radial-gradient(ellipse 80% 50% at 50% 50%, rgba(40,40,40,0.15) 0%, transparent 70%);"
          ></div>
          <!-- Subtle top/bottom fade for card fade-out -->
          <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black opacity-40"></div>
        </div>

      <!-- =======================================================
           Marquees — space-between: top = max top, bottom = max bottom
           This ensures 404 text is truly centered (main is justify-center)
           ======================================================= -->
      <div
        class="pointer-events-none absolute inset-0 z-[1] flex h-full w-full flex-col justify-between overflow-hidden select-none py-3 md:py-4"
        style="perspective: 600px; perspective-origin: 50% 50%;"
      >
        <!-- Fade masks for left/right edges -->
        <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-20 bg-gradient-to-b from-black to-transparent">
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-black to-transparent">
        </div>
        <div
          class="pointer-events-none absolute inset-0 z-10"
          style="mask-image:linear-gradient(to right,transparent,black 7%,black 93%,transparent);-webkit-mask-image:linear-gradient(to right,transparent,black 7%,black 93%,transparent)"
        >
        </div>

        <!-- TOP: ceiling fan — perspective tilt + slow right drift -->
        <div class="flex shrink-0 flex-col gap-2.5 pt-1 md:gap-3">
          {top.map((row, i) => (
            <div class="relative w-full overflow-hidden">
              <div class={`persp-top drift-right flex w-max gap-2.5 d${[45, 55, 48][i]}`}>
                {x3(row).map((t) => (
                  <a href="#" class="box">
                    <span class="truncate">{t}</span>
                    <span class="ico">↗</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- BOTTOM: floor fan — perspective tilt + slow left drift -->
        <div class="flex shrink-0 flex-col gap-2.5 pb-1 md:gap-3">
          {bottom.map((row, i) => (
            <div class="relative w-full overflow-hidden">
              <div class={`persp-bottom drift-left flex w-max gap-2.5 d${[38, 55, 44][i]}`}>
                {x3(row).map((t) => (
                  <a href="#" class="box">
                    <span class="truncate">{t}</span>
                    <span class="ico">↗</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- =======================================================
           Center — 404: true center because main justify-center + marquees absolute
           ======================================================= -->
      <div class="relative z-20 flex w-full flex-col items-center px-4 py-10 text-center md:px-6">
        <div class="in flex flex-col items-center">
          <h1
            class="t404 select-none font-[800] leading-[0.85] tracking-[-0.08em] text-white"
          >
            404
          </h1>

          <p class="mt-4 text-[18px] font-medium tracking-tight text-white md:text-[20px] md:font-semibold">
            Page not found
          </p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/"
              class="rounded-full border border-white/20 bg-white/[0.07] px-6 py-2.5 text-[14px] font-semibold text-zinc-100 backdrop-blur-sm hover:bg-white/[0.12] active:scale-[0.98] md:px-7 md:py-[11px] md:text-[15px]"
              style="@supports not (backdrop-filter: blur(1px)) { background: rgba(255,255,255,0.12); }"
            >
              Back to Home
            </a>

            <button
              id="back"
              class="rounded-full border border-white/10 bg-white/[0.04] px-6 py-2.5 text-[14px] font-medium text-zinc-400 hover:border-white/20 hover:text-zinc-200 active:scale-[0.98] md:px-7 md:py-[11px]"
            >
              Go Back
            </button>
          </div>

          <p class="mt-6 max-w-[28ch] text-balance text-[12px] leading-5 text-zinc-500 md:text-[13px]">
            <span
              id="url-path"
              class="rounded border border-white/10 bg-white/[0.06] px-1.5 py-0.5 font-mono text-zinc-400"
            >
              {Astro.url.pathname}
            </span>
            {" "}doesn't exist.
          </p>
        </div>
      </div>

      <!-- =======================================================
           Styles
           ======================================================= -->
      <style>
        /* 404 title responsive */
        .t404 {
          font-size: clamp(84px, 28vw, 200px);
          font-weight: 800;
          line-height: 0.85;
          letter-spacing: -0.08em;
          text-rendering: geometricPrecision;
        }

        /* Entry animation */
        .in {
          animation: in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        @keyframes in {
          from {
            opacity: 0;
            transform: translateY(16px) scale(0.98);
            filter: blur(8px);
          }
          to {
            opacity: 1;
            transform: none;
            filter: none;
          }
        }

        /* CARD: glassmorphism — semi-transparent grey, light border, luminous */
        .box {
          display: inline-flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          min-width: 200px;
          max-width: min(420px, 78vw);
          padding: 11px 14px 11px 16px;
          border-radius: 14px;
          border: 1px solid rgba(255, 255, 255, 0.15);
          background: rgba(255, 255, 255, 0.07);
          color: #d4d4d4;
          font-size: 13px;
          font-weight: 400;
          line-height: 1.35;
          white-space: nowrap;
          backdrop-filter: blur(4px);
          -webkit-backdrop-filter: blur(4px);
          box-shadow:
            0 2px 8px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }
        @supports not (backdrop-filter: blur(1px)) {
          .box {
            background: rgba(255, 255, 255, 0.12);
          }
        }
        .ico {
          display: flex;
          flex-shrink: 0;
          height: 20px;
          width: 20px;
          align-items: center;
          justify-content: center;
          border-radius: 9999px;
          background: rgba(255, 255, 255, 0.12);
          color: #d4d4d4;
          font-size: 12px;
          font-weight: 600;
          line-height: 1;
        }

        /* Perspective grid — ceiling (top) fans up, floor (bottom) fans down */
        .persp-top {
          transform: rotateX(-32deg);
          transform-origin: center bottom;
        }
        .persp-bottom {
          transform: rotateX(32deg);
          transform-origin: center top;
        }

        /* Seamless slow drift — content is tripled (x3) so -33.333% = exactly one loop */
        .drift-right {
          animation-name: drift-right;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
          will-change: transform;
        }
        .drift-left {
          animation-name: drift-left;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
          will-change: transform;
        }

        @keyframes drift-right {
          0%   { transform: rotateX(-32deg) translateX(0); }
          100% { transform: rotateX(-32deg) translateX(-33.333%); }
        }
        @keyframes drift-left {
          0%   { transform: rotateX(32deg) translateX(-33.333%); }
          100% { transform: rotateX(32deg) translateX(0); }
        }

        /* Per-row speeds — all referenced classes defined (was missing d38/d44/d48) */
        .d38 { animation-duration: 26s; }
        .d44 { animation-duration: 30s; }
        .d45 { animation-duration: 32s; }
        .d48 { animation-duration: 35s; }
        .d55 { animation-duration: 40s; }

        @media (max-width: 768px) {
          .box {
            min-width: 160px;
            max-width: 70vw;
            padding: 10px 12px 10px 14px;
            font-size: 12px;
            border-radius: 12px;
          }
          .t404 {
            font-size: clamp(72px, 26vw, 140px);
          }
          /* Clamp perspective tilt on mobile — prevent off-screen content */
          .persp-top { transform: rotateX(-20deg); }
          .persp-bottom { transform: rotateX(20deg); }
          .drift-right, .drift-left { animation: none; }
          .d45 { animation-duration: 28s; }
          .d55 { animation-duration: 32s; }
        }

        @media (prefers-reduced-motion: reduce) {
          .in { animation: none; }
          .persp-top, .persp-bottom { transform: none; }
          .drift-right, .drift-left { animation: none; }
        }
      </style>
    </main>

    <!-- Capture real pathname client-side (static build bakes /404/ at build time) -->
    <script define:vars={{ currentPath: Astro.url.pathname }}>
      // Fix: update the URL display span with the real client-side pathname
      const urlSpan = document.getElementById("url-path");
      if (urlSpan) {
        urlSpan.textContent = currentPath;
      }
      // Back button logic
      document.getElementById("back")?.addEventListener("click", (e) => {
        e.preventDefault();
        if (history.length > 1) {
          history.back();
        } else {
          location.href = "/";
        }
      });
    </script>
  </body>
</html>
