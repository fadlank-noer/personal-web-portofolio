---
import "../styles/global.css";
import SideToggleMobile from '../../public/assets/svgs/side-toggle-mobile.svg';
import Sidebar from "../features/sidebar/components/Sidebar.astro";
import LinkConfirmationModal from "../components/ui/chat/LinkConfirmationModal.astro";
import Head from "../layouts/Head.astro";
import socialsData from "../data/socials.json";
import type { SocialLink } from "../lib/types/social";

const socials = socialsData satisfies SocialLink[];
const categories = ["All", ...new Set(socials.map((s) => s.category))];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <Head />
  </head>
  <body class="bg-black text-white antialiased overflow-hidden">
    <div class="flex h-[100dvh] w-full overflow-hidden bg-black">
      <Sidebar />

      <main class="flex flex-1 flex-col min-w-0 bg-black overflow-y-auto chat-scrollbar">
        <!-- Top bar -->
        <div class="sticky top-0 z-10 flex h-[52px] items-center justify-between border-b border-white/[0.06] bg-black/85 px-3 md:px-6 backdrop-blur">
          <div class="flex items-center gap-2">
            <!-- Mobile sidebar toggle -->
            <button id="mobile-sidebar-toggle" class="flex md:hidden h-9 w-9 items-center justify-center rounded-full text-white hover:bg-[#1a1a1a] transition-colors -ml-1" aria-label="Toggle sidebar">
              <SideToggleMobile class="h-[22px] w-[22px] text-white" />
            </button>
            <span class="hidden md:flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#1a1a1a] border border-white/[0.06]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] text-violet-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            </span>
            <h1 class="text-[15px] font-[700] tracking-[-0.02em] text-white">My Socials</h1>
            <span class="ml-1 rounded-full bg-[#1a1a1a] border border-white/[0.06] px-2 py-0.5 text-[11px] font-[500] text-zinc-400">{socials.length} profiles</span>
          </div>
        </div>

        <div class="mx-auto w-full max-w-[1280px] px-3 py-4 md:px-6 md:py-8">

          <!-- Search -->
          <div class="relative mb-6 max-w-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              id="social-search"
              type="search"
              placeholder="Search socials..."
              autocomplete="off"
              class="w-full bg-[#1a1a1a] border border-white/[0.08] rounded-2xl pl-12 pr-4 py-3.5 text-[15px] text-white placeholder-zinc-500 outline-none focus:border-white/[0.16] focus:ring-1 focus:ring-white/[0.08] transition-colors"
            />
          </div>

          <!-- Category Tabs -->
          <div
            id="category-tabs"
            role="tablist"
            class="flex items-center gap-6 border-b border-white/[0.06] pb-0 mb-6 overflow-x-auto scrollbar-hide"
          >
            {categories.map((cat) => (
              <button
                type="button"
                role="tab"
                data-category={cat}
                class="category-tab text-sm font-medium text-zinc-400 hover:text-white transition-colors pb-3 border-b-2 border-transparent data-[active=true]:text-white data-[active=true]:border-white whitespace-nowrap flex-shrink-0"
                aria-selected="false"
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Card Grid -->
          <div id="social-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {socials.map((social) => (
              <a
                href={social.url}
                data-link-trigger
                data-link-url={social.url}
                data-link-label={social.platform}
                data-platform={social.platform.toLowerCase()}
                data-handle={social.handle.toLowerCase()}
                data-category={social.category}
                class="social-card group block bg-[#1a1a1a] border border-white/[0.06] rounded-2xl p-5 hover:border-white/[0.14] hover:bg-[#202020] transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
              >
                <!-- Icon + platform -->
                <div class="flex items-start gap-4 mb-3">
                  <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-[#252525] border border-white/[0.08] flex items-center justify-center">
                    <span class="text-lg font-bold text-white/80">{social.platform.charAt(0)}</span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-[15px] font-semibold text-white leading-tight truncate">{social.platform}</p>
                    <p class="text-[13px] text-zinc-500 truncate">{social.handle}</p>
                  </div>
                </div>
                <!-- Description -->
                <p class="text-[13px] text-zinc-400 leading-relaxed line-clamp-2 mb-3">{social.description}</p>
              </a>
            ))}
          </div>

          <!-- Empty state -->
          <div id="social-empty" class="hidden text-center py-16">
            <p class="text-zinc-500 text-[15px]">No social profiles match your search.</p>
          </div>

        </div>
      </main>
    </div>
  </body>
</html>

<script>
  // ── Mobile sidebar toggle ───────────────────────────────────
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const toggle = document.getElementById('mobile-sidebar-toggle');
  const isMobile = () => window.innerWidth < 768;
  const applyMobile = (open: boolean) => {
    if (!sidebar || !overlay) return;
    sidebar.dataset.mobileOpen = open ? 'true' : 'false';
    overlay.classList.toggle('hidden', !open);
  };
  toggle?.addEventListener('click', () => {
    if (!sidebar) return;
    const cur = sidebar.dataset.mobileOpen === 'true';
    applyMobile(!cur);
  });
  overlay?.addEventListener('click', () => applyMobile(false));
  window.addEventListener('resize', () => {
    if (!isMobile() && sidebar && overlay) {
      sidebar.dataset.mobileOpen = 'false';
      overlay.classList.add('hidden');
    }
  });

  // ── Search + category filter ────────────────────────────────
  const searchInput = document.getElementById('social-search') as HTMLInputElement;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.social-card'));
  const emptyState = document.getElementById('social-empty');
  let activeCategory = 'All';

  // Category tab: click
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeCategory = tab.dataset.category || 'All';
      tabs.forEach((t) => {
        const isActive = t.dataset.category === activeCategory;
        t.dataset.active = String(isActive);
        t.setAttribute('aria-selected', String(isActive));
      });
      filterCards();
    });
  });

  // Category tab: keyboard arrow nav
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const visibleTabs = Array.from(tabs).filter((t) => {
      const cat = t.dataset.category || 'All';
      return cat === 'All' || cards.some((c) => c.dataset.category === cat);
    });
    const idx = visibleTabs.findIndex((t) => t.dataset.category === activeCategory);
    let next = idx + (e.key === 'ArrowRight' ? 1 : -1);
    if (next < 0) next = visibleTabs.length - 1;
    if (next >= visibleTabs.length) next = 0;
    visibleTabs[next].click();
    visibleTabs[next].focus();
  });

  // Search filter
  searchInput?.addEventListener('input', filterCards);

  function filterCards() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let visible = 0;
    cards.forEach((card) => {
      const matchesCategory = activeCategory === 'All' || card.dataset.category === activeCategory;
      const platform = (card.dataset.platform || '').toLowerCase();
      const handle = (card.dataset.handle || '').toLowerCase();
      const matchesSearch = !query || platform.includes(query) || handle.includes(query);
      const show = matchesCategory && matchesSearch;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  // Init: set first tab active
  const firstTab = document.querySelector<HTMLButtonElement>('.category-tab');
  if (firstTab) {
    firstTab.dataset.active = 'true';
    firstTab.setAttribute('aria-selected', 'true');
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  input[type="search"]::-webkit-search-cancel-button { -webkit-appearance: none; }
  .chat-scrollbar { scrollbar-width: thin; scrollbar-color: #2a2a2a #0a0a0a; }
  .chat-scrollbar::-webkit-scrollbar { width: 6px; }
  .chat-scrollbar::-webkit-scrollbar-track { background: #0a0a0a; }
  .chat-scrollbar::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 9999px; }
  .chat-scrollbar::-webkit-scrollbar-thumb:hover { background: #3a3a3a; }
</style>

<LinkConfirmationModal />