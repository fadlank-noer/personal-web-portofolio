---
import logoLight from "../assets/logo-v2-light.webp";
import logoDark from "../assets/logo-v2-dark.webp";
import faviconIco from "../assets/favicon/favicon.ico";
import favicon16 from "../assets/favicon/favicon-16x16.png";
import favicon32 from "../assets/favicon/favicon-32x32.png";
import appleTouchIcon from "../assets/favicon/apple-touch-icon.png";
const OG_IMAGE_URL = `https://fadlank.web.id${logoLight.src}`;
---
<meta charset="utf-8" />
<title>Fadlan Kautsar Noer - Fullstack Programmer Jakarta Selatan</title>

<!-- SEO Meta Tags -->
<meta name="description" content="Saya adalah programmer fullstack yang ada di Jagakarsa Jakarta Selatan. Spesialisasi dalam pengembangan web modern dengan React, Vue, Svelte, dan teknologi fullstack lainnya." />
<meta name="keywords" content="programmer fullstack, developer jakarta, web developer jakarta selatan, jagakarsa programmer, fullstack engineer indonesia, software engineer jakarta" />
<meta name="author" content="Fadlan Kautsar Noer" />
<meta name="robots" content="index, follow" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Open Graph Meta Tags -->
<meta property="og:title" content="Fadlan Kautsar Noer - Fullstack Programmer Jakarta Selatan" />
<meta property="og:description" content="Saya adalah programmer fullstack dan system yang ada di Jagakarsa Jakarta Selatan. Spesialisasi dalam pengembangan web modern dan sistem." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://fadlank.web.id" />
<meta property="og:image" content={OG_IMAGE_URL} />
<meta property="og:locale" content="id_ID" />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Fadlan Kautsar Noer - Fullstack Programmer Jakarta Selatan" />
<meta name="twitter:description" content="Saya adalah programmer fullstack yang ada di Jagakarsa Jakarta Selatan. Spesialisasi dalam pengembangan web modern." />
<meta name="twitter:image" content={OG_IMAGE_URL} />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href={(faviconIco as unknown as { src: string }).src} />
<link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
<link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
<link rel="apple-touch-icon" href={appleTouchIcon.src} />

<!-- Canonical URL -->
<link rel="canonical" href="https://fadlank.web.id" />
