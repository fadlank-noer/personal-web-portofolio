---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Sidebar from "../components/Sidebar.astro";
import ChatHistory from "../components/ChatHistory.astro";
import ChatBox from "../components/ChatBox.astro";
---

<script>
  import Alpine from 'alpinejs';
  import { $hasChats, setHasChats } from '../stores/chat';

  // Alpine stores - ChatGPT-like
  Alpine.store('chat', { hasChats: false });
  Alpine.store('sidebar', {
    collapsed: false,
    mobileOpen: false,
    toggle() { this.collapsed = !this.collapsed; },
    toggleMobile() { this.mobileOpen = !this.mobileOpen; },
    closeMobile() { this.mobileOpen = false; }
  });

  (window as any).setHasChats = setHasChats;

  $hasChats.subscribe((value) => {
    try { Alpine.store('chat').hasChats = value; } catch {}
  });

  Alpine.start();
</script>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Head />
  </head>
  <body class="bg-black text-white antialiased overflow-hidden">
    <!-- GPT-like layout: Sidebar kiri + Main content -->
    <div class="flex h-screen w-full overflow-hidden bg-black">
      <!-- Sidebar kiri -->
      <Sidebar />

      <!-- Main content: ChatHistory DI ATAS, ChatBox DI BAWAH setelah submit -->
      <main class="flex flex-1 flex-col min-w-0 bg-black relative overflow-hidden">
        <!-- Mobile header - hamburger -->
        <div class="flex md:hidden items-center justify-between px-4 py-3 border-b border-[#2b2b2b] flex-shrink-0 bg-black">
          <button
            onclick="window.toggleSidebar?.()"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-400 hover:text-white hover:bg-[#2b2b2b]"
            aria-label="Open sidebar"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>
          <p class="text-sm font-medium">FadlanGPT</p>
          <div class="w-8"></div>
        </div>

        <!-- ChatHistory DI ATAS - flex-1 scrollable -->
        <div class="flex flex-1 flex-col min-h-0 overflow-hidden">
          <ChatHistory class="flex-1" />
        </div>

        <!-- ChatBox DI BAWAH - sticky bottom, input bar -->
        <div class="flex-shrink-0 bg-black relative">
          <!-- Gradient fade like ChatGPT -->
          <div class="pointer-events-none absolute -top-8 left-0 right-0 h-8 bg-gradient-to-t from-black to-transparent"></div>
          <ChatBox />
        </div>
      </main>
    </div>

    <!-- Slot for other pages (not used on index but kept) -->
    <slot />
  </body>
</html>
