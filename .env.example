# Cloudflare Pages Direct Upload — required for non-interactive (CI/local) deploy
# Create a scoped API token at https://dash.cloudflare.com/profile/api-tokens
# Token needs: Account > Cloudflare Pages > Edit
# Then copy this file to `.env` and paste your token below (DO NOT commit .env).
CLOUDFLARE_API_TOKEN=

# Substack prebuild (scripts/prebuild.mjs) — fetched before `npm run build`.
# On GitHub Actions these come from repo secrets instead (see
# .github/workflows/deploy.yml); the values below mirror the CI fallbacks.
SUBSTACK_PUBLICATION_URL=https://fadlansthought.substack.com/
SUBSTACK_LIMIT=10
SUBSTACK_SORT=new
